import { SpecItem, VaultVideoItem, Theme } from "theme.slint";
import { FloatingDetailsButton } from "components/floating_button.slint";
import { ShowroomView } from "views/showroom_view.slint";
import { QuickSetupView } from "views/quick_setup_view.slint";
import { AdminView } from "views/admin_view.slint";
import { ScreensaverView } from "views/screensaver_view.slint";

export { SpecItem, VaultVideoItem, FloatingDetailsButton }

export component MainWindow inherits Window {
    title: "Showroom PC - Modo Exhibición";
    no-frame: true;
    full-screen: true;
    preferred-width: 1920px;
    preferred-height: 1080px;
    background: #f1f5f9;

    // Showroom Properties
    in-out property <string> brand_name: "ASUS";
    in-out property <string> model_name: "ROG STRIX G16";
    in-out property <string> live_clock: "12:00:00";
    in-out property <string> retail_name: "";
    in-out property <string> card_price: "";
    in-out property <string> card_label: "Precio Tarjeta";
    in-out property <string> normal_price: "";
    in-out property <string> normal_label: "Todo medio de pago";
    in-out property <string> sku_code: "";
    in-out property <image> store_logo;
    in-out property <image> brand_logo;
    in-out property <bool> has_brand_logo: false;
    in-out property <image> brand_logo_dark;
    in-out property <bool> has_brand_logo_dark: false;
    in-out property <bool> is_dark_bg: false;

    // Specs
    in-out property <[SpecItem]> left_specs: [
        { category: "PROCESADOR", value: "Intel Core i7-13650HX", subvalue: "14 núcleos, 20 hilos", tag: "GEN 13", icon: @image-url("../assets/ui/cpu.svg") },
        { category: "MEMORIA RAM", value: "16 GB DDR5 4800MHz", subvalue: "Expandible a 32 GB", tag: "DDR5", icon: @image-url("../assets/ui/ram.svg") },
        { category: "ALMACENAMIENTO", value: "512 GB SSD NVMe M.2", subvalue: "PCIe 4.0 de alta velocidad", tag: "NVMe", icon: @image-url("../assets/ui/storage.svg") },
        { category: "SISTEMA OPERATIVO", value: "Windows 11 Home", subvalue: "64-bit con licencia oficial", tag: "OFICIAL", icon: @image-url("../assets/ui/software.svg") }
    ];
    in-out property <[SpecItem]> right_specs: [
        { category: "PANTALLA", value: "16\" FHD+ 165Hz IPS", subvalue: "100% sRGB, 7ms, G-Sync", tag: "165Hz", icon: @image-url("../assets/ui/screen.svg") },
        { category: "GRÁFICOS", value: "NVIDIA GeForce RTX 4060", subvalue: "8 GB GDDR6 dedicados", tag: "RTX", icon: @image-url("../assets/ui/gpu.svg") },
        { category: "BATERÍA", value: "Batería 42 Wh", subvalue: "Batería de larga duración", tag: "Autonomía", icon: @image-url("../assets/ui/battery.svg") },
        { category: "OTROS Y CONECTIVIDAD", value: "Wi-Fi 6E / Bluetooth 5.4 / Teclado en Español", subvalue: "", tag: "", icon: @image-url("../assets/ui/features.svg") }
    ];

    // Modals & State
    in-out property <bool> is_quick_setup_open: false;
    in-out property <bool> is_admin_open: false;
    in-out property <bool> is_admin_authenticated: false;
    in-out property <bool> is_screensaver_active: false;
    in-out property <string> admin_error_msg: "";
    in-out property <bool> show_toast: false;
    in-out property <string> toast_message: "Cambios aplicados y guardados con éxito";

    // Video Streams (libmpv)
    in-out property <image> video_frame;
    in-out property <bool> has_video_stream: false;
    in-out property <image> bg_video_frame;
    in-out property <bool> has_bg_video: false;

    // Screen Dimensions for Fullscreen Auto-Scaling
    in-out property <length> screen_width: 1920px;
    in-out property <length> screen_height: 1080px;

    // Quick Setup Form Fields
    in-out property <string> setup_brand: "";
    in-out property <string> setup_model: "";
    in-out property <string> setup_retail: "";
    in-out property <string> setup_card_price: "";
    in-out property <string> setup_normal_price: "";
    in-out property <string> setup_sku: "";

    // Admin Inputs & Tabs
    in-out property <string> admin_password_input: "";
    in-out property <int> admin_tab_index: 0;

    // Admin Tab Tienda
    in-out property <string> cfg_brand: "";
    in-out property <string> cfg_brand_logo: "";
    in-out property <string> cfg_model: "";
    in-out property <string> cfg_retail: "";
    in-out property <string> cfg_store_logo: "";
    in-out property <string> cfg_card_price: "";
    in-out property <string> cfg_normal_price: "";
    in-out property <string> cfg_sku: "";

    // Admin Tab Especificaciones
    in-out property <string> cfg_cpu: "";
    in-out property <string> cfg_ram: "";
    in-out property <string> cfg_storage: "";
    in-out property <string> cfg_gpu: "";
    in-out property <string> cfg_display: "";
    in-out property <string> cfg_os: "";
    in-out property <string> cfg_battery: "";
    in-out property <string> cfg_others: "";
    in-out property <string> cfg_badge_cpu: "";
    in-out property <string> cfg_badge_ram: "";
    in-out property <string> cfg_badge_storage: "";
    in-out property <string> cfg_badge_gpu: "";
    in-out property <string> cfg_badge_display: "";
    in-out property <string> cfg_badge_os: "";
    in-out property <string> cfg_badge_battery: "";
    in-out property <string> cfg_badge_others: "";
    in-out property <string> placeholder_badge_cpu: "GEN";
    in-out property <string> placeholder_badge_ram: "RAM";
    in-out property <string> placeholder_badge_storage: "SSD";
    in-out property <string> placeholder_badge_gpu: "GPU";
    in-out property <string> placeholder_badge_display: "165Hz";
    in-out property <string> placeholder_badge_os: "";
    in-out property <string> placeholder_badge_battery: "";
    in-out property <string> placeholder_badge_others: "";

    // Admin Tab Videos & Baúl
    in-out property <string> cfg_central_video: "";
    in-out property <string> cfg_bg_video: "";
    in-out property <string> cfg_inactivity_video_1: "";
    in-out property <string> cfg_inactivity_video_2: "";
    in-out property <string> cfg_inactivity_video_3: "";
    in-out property <string> cfg_inactivity_timeout: "120";
    in-out property <[VaultVideoItem]> vault_videos: [];

    pure callback hex_to_color(string) -> color;

    // Admin Tab Interfaz (Config strings)
    in-out property <string> cfg_bg_base: "#e3e8f5";
    in-out property <string> cfg_bg_start: "#dcedf5";
    in-out property <string> cfg_bg_mid: "#e3e8f5";
    in-out property <string> cfg_bg_end: "#eae4f5";
    in-out property <string> cfg_card_bg: "#F5F5F5";
    in-out property <string> cfg_card_border: "#bae6fd";
    in-out property <string> cfg_text_primary: "#0f172a";
    in-out property <string> cfg_text_secondary: "#475569";
    in-out property <string> cfg_accent: "#0284c7";
    in-out property <string> cfg_btn_bg: "#0284c7";
    in-out property <string> cfg_btn_text: "#F5F5F5";
    in-out property <bool> is_dark_mode: false;

    // Theme Colors (Dynamically bound to cfg_* in real-time)
    in-out property <color> theme_bg_start: root.hex_to_color(root.cfg_bg_start);
    in-out property <color> theme_bg_mid: root.hex_to_color(root.cfg_bg_mid);
    in-out property <color> theme_bg_end: root.hex_to_color(root.cfg_bg_end);
    in-out property <color> theme_card_bg: root.hex_to_color(root.cfg_card_bg);
    in-out property <color> theme_card_border: root.hex_to_color(root.cfg_card_border);
    in-out property <color> theme_text_primary: root.hex_to_color(root.cfg_text_primary);
    in-out property <color> theme_text_secondary: root.hex_to_color(root.cfg_text_secondary);
    in-out property <color> theme_accent: root.hex_to_color(root.cfg_accent);
    in-out property <color> theme_btn_bg: root.hex_to_color(root.cfg_btn_bg);
    in-out property <color> theme_btn_text: root.hex_to_color(root.cfg_btn_text);

    // Callbacks
    callback update_bg_base_color(string);
    callback try_pc_clicked();
    callback corner_tap_clicked();
    callback close_admin_clicked();
    callback check_admin_password(string);
    callback emergency_exit_clicked();
    callback emergency_restart_clicked();
    callback auto_detect_clicked();
    callback save_quick_setup(string, string, string, string, string, string);
    callback format_currency_input(string) -> string;
    callback save_admin_config(
        string, string, string, string, string, string,
        string, string, string, string, string, string, string, string,
        string, string, string, string, string, string
    );
    callback dismiss_screensaver();
    callback import_video_to_vault_clicked();
    callback delete_vault_video_clicked(string);
    callback reset_store_defaults();
    callback reset_specs_defaults();
    callback reset_videos_defaults();
    callback reset_system_defaults();
    callback reset_ui_defaults();
    callback pick_central_video_clicked();
    callback pick_bg_video_clicked();
    callback pick_inactivity_1_clicked();
    callback pick_inactivity_2_clicked();
    callback pick_inactivity_3_clicked();
    callback pick_color_clicked(string);
    callback pick_brand_logo_clicked();
    callback pick_store_logo_clicked();

    forward-focus: root_focus;
    root_focus := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && event.modifiers.alt && event.modifiers.shift {
                if event.text == "z" || event.text == "Z" {
                    root.emergency_exit_clicked();
                    return accept;
                }
                if event.text == "r" || event.text == "R" {
                    root.emergency_restart_clicked();
                    return accept;
                }
            }
            reject
        }
    }

    // 1. Showroom Main View
    ShowroomView {
        brand_name: root.brand_name;
        model_name: root.model_name;
        live_clock: root.live_clock;
        retail_name: root.retail_name;
        card_price: root.card_price;
        card_label: root.card_label;
        normal_price: root.normal_price;
        normal_label: root.normal_label;
        sku_code: root.sku_code;
        left_specs: root.left_specs;
        right_specs: root.right_specs;
        video_frame: root.video_frame;
        has_video_stream: root.has_video_stream;
        screen_width: root.screen_width;
        screen_height: root.screen_height;
        store_logo: root.store_logo;
        brand_logo: root.brand_logo;
        has_brand_logo: root.has_brand_logo;
        brand_logo_dark: root.brand_logo_dark;
        has_brand_logo_dark: root.has_brand_logo_dark;
        is_dark_mode: root.is_dark_mode;
        is_dark_bg: root.is_dark_mode || root.is_dark_bg;

        theme_bg_start: root.hex_to_color(root.cfg_bg_start);
        theme_bg_mid: root.hex_to_color(root.cfg_bg_mid);
        theme_bg_end: root.hex_to_color(root.cfg_bg_end);
        theme_card_bg: root.hex_to_color(root.cfg_card_bg);
        theme_card_border: root.hex_to_color(root.cfg_card_border);
        theme_text_primary: root.hex_to_color(root.cfg_text_primary);
        theme_text_secondary: root.hex_to_color(root.cfg_text_secondary);
        theme_accent: root.hex_to_color(root.cfg_accent);
        theme_btn_bg: root.hex_to_color(root.cfg_btn_bg);
        theme_btn_text: root.hex_to_color(root.cfg_btn_text);

        try_pc_clicked => { root.try_pc_clicked(); }
        corner_tap_clicked => { root.corner_tap_clicked(); }
    }

    // 2. Quick Setup Wizard (First Launch)
    if root.is_quick_setup_open: QuickSetupView {
        setup_brand <=> root.setup_brand;
        setup_model <=> root.setup_model;
        setup_retail <=> root.setup_retail;
        setup_card_price <=> root.setup_card_price;
        setup_normal_price <=> root.setup_normal_price;
        setup_sku <=> root.setup_sku;
        auto_detect_clicked => { root.auto_detect_clicked(); }
        format_currency_input(val) => { return root.format_currency_input(val); }
        save_quick_setup(brand, model, card_price, normal_price, sku, retail) => {
            root.save_quick_setup(brand, model, card_price, normal_price, sku, retail);
        }
        close_quick_setup => { root.is_quick_setup_open = false; }
    }

    // 3. Admin Panel Modal
    if root.is_admin_open: AdminView {
        is_admin_authenticated <=> root.is_admin_authenticated;
        admin_password_input <=> root.admin_password_input;
        admin_error_msg <=> root.admin_error_msg;
        admin_tab_index <=> root.admin_tab_index;

        cfg_brand <=> root.cfg_brand;
        cfg_brand_logo <=> root.cfg_brand_logo;
        cfg_model <=> root.cfg_model;
        cfg_retail <=> root.cfg_retail;
        cfg_store_logo <=> root.cfg_store_logo;
        cfg_card_price <=> root.cfg_card_price;
        cfg_normal_price <=> root.cfg_normal_price;
        cfg_sku <=> root.cfg_sku;

        cfg_cpu <=> root.cfg_cpu;
        cfg_ram <=> root.cfg_ram;
        cfg_storage <=> root.cfg_storage;
        cfg_gpu <=> root.cfg_gpu;
        cfg_display <=> root.cfg_display;
        cfg_os <=> root.cfg_os;
        cfg_battery <=> root.cfg_battery;
        cfg_others <=> root.cfg_others;
        cfg_badge_cpu <=> root.cfg_badge_cpu;
        cfg_badge_ram <=> root.cfg_badge_ram;
        cfg_badge_storage <=> root.cfg_badge_storage;
        cfg_badge_gpu <=> root.cfg_badge_gpu;
        cfg_badge_display <=> root.cfg_badge_display;
        cfg_badge_os <=> root.cfg_badge_os;
        cfg_badge_battery <=> root.cfg_badge_battery;
        cfg_badge_others <=> root.cfg_badge_others;
        placeholder_badge_cpu: root.placeholder_badge_cpu;
        placeholder_badge_ram: root.placeholder_badge_ram;
        placeholder_badge_storage: root.placeholder_badge_storage;
        placeholder_badge_gpu: root.placeholder_badge_gpu;
        placeholder_badge_display: root.placeholder_badge_display;
        placeholder_badge_os: root.placeholder_badge_os;
        placeholder_badge_battery: root.placeholder_badge_battery;
        placeholder_badge_others: root.placeholder_badge_others;

        cfg_central_video <=> root.cfg_central_video;
        cfg_bg_video <=> root.cfg_bg_video;
        cfg_inactivity_video_1 <=> root.cfg_inactivity_video_1;
        cfg_inactivity_video_2 <=> root.cfg_inactivity_video_2;
        cfg_inactivity_video_3 <=> root.cfg_inactivity_video_3;
        cfg_inactivity_timeout <=> root.cfg_inactivity_timeout;
        vault_videos: root.vault_videos;

        cfg_bg_base <=> root.cfg_bg_base;
        cfg_bg_start <=> root.cfg_bg_start;
        cfg_bg_mid <=> root.cfg_bg_mid;
        cfg_bg_end <=> root.cfg_bg_end;
        cfg_card_bg <=> root.cfg_card_bg;
        cfg_card_border <=> root.cfg_card_border;
        cfg_text_primary <=> root.cfg_text_primary;
        cfg_text_secondary <=> root.cfg_text_secondary;
        cfg_accent <=> root.cfg_accent;
        cfg_btn_bg <=> root.cfg_btn_bg;
        cfg_btn_text <=> root.cfg_btn_text;
        is_dark_mode <=> root.is_dark_mode;

        update_bg_base_color(c) => { root.update_bg_base_color(c); }

        close_admin_clicked => { root.close_admin_clicked(); }
        check_admin_password(pwd) => { root.check_admin_password(pwd); }
        emergency_exit_clicked => { root.emergency_exit_clicked(); }
        emergency_restart_clicked => { root.emergency_restart_clicked(); }
        auto_detect_clicked => { root.auto_detect_clicked(); }
        format_currency_input(val) => { return root.format_currency_input(val); }
        save_admin_config(
            b, m, r, cp, np, sk,
            cpu, ram, st, gpu, disp, os, bat, oth,
            cv, bg, iv1, iv2, iv3, it
        ) => {
            root.save_admin_config(
                b, m, r, cp, np, sk,
                cpu, ram, st, gpu, disp, os, bat, oth,
                cv, bg, iv1, iv2, iv3, it
            );
        }
        import_video_to_vault_clicked => { root.import_video_to_vault_clicked(); }
        delete_vault_video_clicked(fn) => { root.delete_vault_video_clicked(fn); }
        reset_store_defaults => { root.reset_store_defaults(); }
        reset_specs_defaults => { root.reset_specs_defaults(); }
        reset_videos_defaults => { root.reset_videos_defaults(); }
        reset_system_defaults => { root.reset_system_defaults(); }
        reset_ui_defaults => { root.reset_ui_defaults(); }
        pick_central_video_clicked => { root.pick_central_video_clicked(); }
        pick_bg_video_clicked => { root.pick_bg_video_clicked(); }
        pick_inactivity_1_clicked => { root.pick_inactivity_1_clicked(); }
        pick_inactivity_2_clicked => { root.pick_inactivity_2_clicked(); }
        pick_inactivity_3_clicked => { root.pick_inactivity_3_clicked(); }
        pick_brand_logo_clicked => { root.pick_brand_logo_clicked(); }
        pick_store_logo_clicked => { root.pick_store_logo_clicked(); }
        pick_color_clicked(field) => { root.pick_color_clicked(field); }
        hex_to_color(hex) => { return root.hex_to_color(hex); }
    }

    // 4. Screensaver Overlay
    if root.is_screensaver_active: ScreensaverView {
        has_video_stream: root.has_video_stream;
        video_frame: root.video_frame;
        brand_name: root.brand_name;
        model_name: root.model_name;
        card_price: root.card_price;
        card_label: root.card_label;
        normal_price: root.normal_price;
        normal_label: root.normal_label;
        retail_name: root.retail_name;
        sku_code: root.sku_code;
        store_logo: root.store_logo;
        theme_accent: root.hex_to_color(root.cfg_accent);
        dismiss_screensaver => { root.dismiss_screensaver(); }
    }

    // 5. Toast Notification (elegante aviso flotante verde de confirmación)
    if root.show_toast: Rectangle {
        x: (parent.width - self.width) / 2;
        y: 28px;
        width: 390px;
        height: 52px;
        border-radius: 14px;
        background: #022c22f2;
        border-width: 1.5px;
        border-color: #10b981;
        clip: true;

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 12px;
            alignment: center;

            Text {
                text: "✓";
                font-size: 20px;
                font-weight: 900;
                color: #34d399;
                vertical-alignment: center;
            }

            Text {
                text: root.toast_message;
                font-size: 13px;
                font-weight: 700;
                color: #ecfdf5;
                vertical-alignment: center;
            }
        }
    }
}
