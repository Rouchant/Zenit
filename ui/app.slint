import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct SpecItem {
    category: string,
    value: string,
    subvalue: string,
    tag: string,
    icon: image,
}

export struct VaultVideoItem {
    name: string,
    filename: string,
    path: string,
    size_str: string,
}

component SpecCard inherits Rectangle {
    in property <string> category: "CATEGORÍA";
    in property <string> value: "Valor Principal";
    in property <string> subvalue: "Detalle adicional";
    in property <string> tag: "TOP";
    in property <color> accent_color: #38bdf8;
    in property <image> icon;

    vertical-stretch: 1;
    background: #0f172a99;
    border-radius: 12px;
    border-width: 1px;
    border-color: #38bdf826;
    clip: true;

    touch := TouchArea {}

    animate border-color { duration: 200ms; }
    animate background { duration: 200ms; }

    states [
        hover when touch.has-hover: {
            background: #1e293bcc;
            border-color: #38bdf880;
        }
    ]

    VerticalLayout {
        alignment: center;
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 6px;

        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                if root.icon.width > 0: Image {
                    source: root.icon;
                    width: 30px;
                    height: 30px;
                    colorize: root.accent_color;
                    vertical-alignment: center;
                }

                Text {
                    text: root.category;
                    font-size: 11px;
                    font-weight: 700;
                    color: #94a3b8;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }

            if root.tag != "": Rectangle {
                background: #0369a140;
                border-radius: 6px;
                border-width: 1px;
                border-color: #38bdf840;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    Text {
                        text: root.tag;
                        font-size: 10px;
                        font-weight: 700;
                        color: #38bdf8;
                    }
                }
            }
        }

        Text {
            text: root.value;
            font-size: 16px;
            font-weight: 700;
            color: #ffffff;
            wrap: word-wrap;
        }

        if root.subvalue != "": Text {
            text: root.subvalue;
            font-size: 12px;
            color: #cbd5e1;
            wrap: word-wrap;
        }
    }
}
export component FloatingDetailsButton inherits Window {
    title: "Zenit - Ver Detalles";
    no-frame: true;
    always-on-top: true;
    width: 200px;
    height: 54px;
    background: transparent;

    callback restore_clicked();

    Rectangle {
        width: 100%;
        height: 100%;
        background: #0f172af5;
        border-radius: 27px;
        border-width: 2px;
        border-color: #38bdf8;
        clip: true;

        touch := TouchArea {
            clicked => {
                root.restore_clicked();
            }
        }

        states [
            hover when touch.has-hover: {
                background: #0284c7;
                border-color: #7dd3fc;
            }
        ]

        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            padding-left: 18px;
            padding-right: 18px;

            Text {
                text: "📋";
                font-size: 16px;
                vertical-alignment: center;
            }
            Text {
                text: "Ver detalles";
                font-size: 15px;
                font-weight: 800;
                color: #ffffff;
                letter-spacing: 0.5px;
                vertical-alignment: center;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Showroom PC - Modo Exhibición";
    no-frame: true;
    full-screen: true;
    preferred-width: 1920px;
    preferred-height: 1080px;
    background: #070a13;

    // Showroom Properties
    in-out property <string> brand_name: "ASUS";
    in-out property <string> model_name: "ROG STRIX G16";
    in-out property <string> live_clock: "12:00:00";
    in-out property <string> retail_name: "";
    in-out property <string> card_price: "";
    in-out property <string> card_label: "Precio Tarjeta";
    in-out property <string> normal_price: "";
    in-out property <string> normal_label: "Todo medio de pago";
    in-out property <string> sku_code: "";

    // Specs
    in-out property <[SpecItem]> left_specs: [
        { category: "PROCESADOR", value: "Intel Core i7-13650HX", subvalue: "14 núcleos, 20 hilos", tag: "GEN 13", icon: @image-url("../assets/ui/cpu.svg") },
        { category: "MEMORIA RAM", value: "16 GB DDR5 4800MHz", subvalue: "Expandible a 32 GB", tag: "DDR5", icon: @image-url("../assets/ui/ram.svg") },
        { category: "ALMACENAMIENTO", value: "512 GB SSD NVMe M.2", subvalue: "PCIe 4.0 de alta velocidad", tag: "NVMe", icon: @image-url("../assets/ui/storage.svg") },
        { category: "SISTEMA OPERATIVO", value: "Windows 11 Home", subvalue: "64-bit con licencia oficial", tag: "OFICIAL", icon: @image-url("../assets/ui/software.svg") }
    ];
    in-out property <[SpecItem]> right_specs: [
        { category: "MARCA Y MODELO", value: "ASUS ROG STRIX G16", subvalue: "Marca: ASUS • Modelo: ROG Strix G16", tag: "ASUS", icon: @image-url("../assets/ui/laptop.svg") },
        { category: "PANTALLA", value: "16\" FHD+ 165Hz IPS", subvalue: "100% sRGB, 7ms, G-Sync", tag: "165Hz", icon: @image-url("../assets/ui/screen.svg") },
        { category: "GRÁFICOS", value: "NVIDIA GeForce RTX 4060", subvalue: "8 GB GDDR6 dedicados", tag: "RTX", icon: @image-url("../assets/ui/gpu.svg") },
        { category: "BATERÍA Y CONECTIVIDAD", value: "Hasta 8 horas", subvalue: "Batería de larga duración", tag: "Autonomía", icon: @image-url("../assets/ui/battery.svg") }
    ];

    // Modals & State
    in-out property <bool> is_quick_setup_open: false;
    in-out property <bool> is_admin_open: false;
    in-out property <bool> is_admin_authenticated: false;
    in-out property <bool> is_screensaver_active: false;
    in-out property <string> admin_error_msg: "";

    // Video Streams (libmpv)
    in-out property <image> video_frame;
    in-out property <bool> has_video_stream: false;
    in-out property <image> bg_video_frame;
    in-out property <bool> has_bg_video: false;

    // Screen Dimensions for Fullscreen Auto-Scaling
    in-out property <length> screen_width: 1920px;
    in-out property <length> screen_height: 1080px;

    // Quick Setup Form Fields
    in-out property <string> setup_brand: "";
    in-out property <string> setup_model: "";
    in-out property <string> setup_retail: "Ripley";
    in-out property <string> setup_card_price: "";
    in-out property <string> setup_normal_price: "";
    in-out property <string> setup_sku: "";

    // Admin Inputs & Tabs
    in-out property <string> admin_password_input: "";
    in-out property <int> admin_tab_index: 0;

    // Admin Tab Tienda
    in-out property <string> cfg_brand: "";
    in-out property <string> cfg_model: "";
    in-out property <string> cfg_retail: "Ripley";
    in-out property <string> cfg_card_price: "";
    in-out property <string> cfg_normal_price: "";
    in-out property <string> cfg_sku: "";

    // Admin Tab Especificaciones
    in-out property <string> cfg_cpu: "";
    in-out property <string> cfg_ram: "";
    in-out property <string> cfg_storage: "";
    in-out property <string> cfg_gpu: "";
    in-out property <string> cfg_display: "";
    in-out property <string> cfg_os: "";
    in-out property <string> cfg_battery: "";
    in-out property <string> cfg_others: "";

    // Admin Tab Videos & Baúl
    in-out property <string> cfg_central_video: "";
    in-out property <string> cfg_bg_video: "";
    in-out property <string> cfg_inactivity_video_1: "";
    in-out property <string> cfg_inactivity_video_2: "";
    in-out property <string> cfg_inactivity_video_3: "";
    in-out property <string> cfg_inactivity_timeout: "120";
    in-out property <[VaultVideoItem]> vault_videos: [];

    // Callbacks
    callback try_pc_clicked();
    callback corner_tap_clicked();
    callback close_admin_clicked();
    callback check_admin_password(string);
    callback emergency_exit_clicked();
    callback emergency_restart_clicked();
    callback auto_detect_clicked();
    callback save_quick_setup(string, string, string, string, string, string);
    callback save_admin_config(
        string, string, string, string, string, string,
        string, string, string, string, string, string, string, string,
        string, string, string, string, string, string
    );
    callback dismiss_screensaver();
    callback import_video_to_vault_clicked();
    callback delete_vault_video_clicked(string);
    callback reset_store_defaults();
    callback reset_specs_defaults();
    callback reset_videos_defaults();
    callback reset_system_defaults();
    callback pick_central_video_clicked();
    callback pick_bg_video_clicked();
    callback pick_inactivity_1_clicked();
    callback pick_inactivity_2_clicked();
    callback pick_inactivity_3_clicked();

    // Root Fullscreen Showroom Surface with High-Tech Dark Gradient
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(155deg, #050811 0%, #0a1224 35%, #070e1c 70%, #03050a 100%);

        // Top-Left Ambient Cyan Aura
        Rectangle {
            width: 700px;
            height: 700px;
            x: -200px;
            y: -200px;
            border-radius: 350px;
            background: @linear-gradient(135deg, #0284c71e 0%, #00000000 75%);
        }

        // Bottom-Right Ambient Azure Aura
        Rectangle {
            width: 800px;
            height: 800px;
            x: parent.width - 500px;
            y: parent.height - 450px;
            border-radius: 400px;
            background: @linear-gradient(315deg, #38bdf818 0%, #00000000 75%);
        }

        // Center Ambient Depth Aura behind Showcase Cards and Central Video
        Rectangle {
            width: 960px;
            height: 700px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 350px;
            background: @linear-gradient(180deg, #0284c70d 0%, #00000000 85%);
        }

        // MAIN CONTENT
        VerticalLayout {
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 20px;
            padding-bottom: 20px;
            spacing: 16px;

            // TOP HEADER BAR
            HorizontalLayout {
                height: 56px;
                alignment: space-between;

            // Brand & Model
            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                Rectangle {
                    width: 4px;
                    height: 40px;
                    background: #38bdf8;
                    border-radius: 2px;
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.brand_name;
                        font-size: 13px;
                        font-weight: 800;
                        color: #38bdf8;
                        letter-spacing: 2px;
                    }
                    Text {
                        text: root.model_name;
                        font-size: 22px;
                        font-weight: 800;
                        color: #ffffff;
                    }
                }
            }

            // Right: Clock & Hidden Trigger
            HorizontalLayout {
                spacing: 16px;
                alignment: end;

                Rectangle {
                    background: #0f172a8c;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #ffffff14;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 6px;
                        padding-bottom: 6px;

                        Text {
                            text: root.live_clock;
                            font-size: 15px;
                            font-weight: 700;
                            color: #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                }

                // 4-tap trigger target (corner)
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 8px;
                    background: #ffffff05;
                    border-width: 1px;
                    border-color: #ffffff0a;

                    TouchArea {
                        clicked => {
                            root.corner_tap_clicked();
                        }
                    }

                    Text {
                        text: "⚙";
                        font-size: 14px;
                        color: #475569;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 3-COLUMN SHOWROOM BODY
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 24px;

            // LEFT COLUMN (Specs 1 to 4)
            Rectangle {
                width: 340px;

                VerticalLayout {
                    spacing: 12px;

                    for item in root.left_specs: SpecCard {
                        category: item.category;
                        value: item.value;
                        subvalue: item.subvalue;
                        tag: item.tag;
                        icon: item.icon;
                        accent_color: #38bdf8;
                    }
                }
            }

            // CENTER HERO (Media & Pricing)
            Rectangle {
                width: max(680px, root.screen_width - 784px);

                VerticalLayout {
                    alignment: center;
                    spacing: 14px;

                    // 16:9 Video Frame
                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: min(parent.width, min(960px, (root.screen_height - 350px) * 16 / 9));
                            height: self.width * 9 / 16;
                            background: #090e1a;
                            border-radius: 18px;
                            border-width: 1.5px;
                            border-color: #38bdf833;
                            clip: true;

                            // Glow background
                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                background: @linear-gradient(180deg, #0284c726 0%, #00000000 100%);
                            }

                            // libmpv Video Stream (16:9)
                            if root.has_video_stream: Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.video_frame;
                                image-fit: cover;
                            }

                            // Center Showcase Badge (shown ONLY when no video stream)
                            if !root.has_video_stream: VerticalLayout {
                                alignment: center;
                                spacing: 14px;
                                padding-left: 30px;
                                padding-right: 30px;

                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 60px;
                                        width: 60px;
                                        border-radius: 30px;
                                        background: #0284c733;
                                        border-width: 2px;
                                        border-color: #38bdf880;

                                        Text {
                                            text: "▶";
                                            font-size: 26px;
                                            color: #38bdf8;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Text {
                                    text: "EQUIPO DISPONIBLE PARA PRUEBA INMEDIATA";
                                    font-size: 12px;
                                    font-weight: 800;
                                    color: #38bdf8;
                                    letter-spacing: 2px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.brand_name + " " + root.model_name;
                                    font-size: 26px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "Experimenta la velocidad, potencia de gráficos y fluidez en tiempo real";
                                    font-size: 13px;
                                    color: #94a3b8;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    // Botón PROBAR ESTA PC (Debajo del componente de video)
                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            height: 52px;
                            width: 300px;
                            border-radius: 26px;
                            background: @linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
                            border-width: 1.5px;
                            border-color: #7dd3fc80;

                            btn_touch := TouchArea {
                                clicked => {
                                    root.try_pc_clicked();
                                }
                            }

                            states [
                                hover when btn_touch.has-hover: {
                                    background: @linear-gradient(135deg, #0369a1 0%, #075985 100%);
                                    border-color: #bae6fd;
                                }
                            ]

                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;

                                Text {
                                    text: "🚀";
                                    font-size: 18px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "PROBAR ESTA PC";
                                    font-size: 15px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    letter-spacing: 1.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // PRICING & SKU BANNER (Hidden if all pricing, SKU and store fields are empty)
                    if root.card_price != "" || root.normal_price != "" || root.sku_code != "" || root.retail_name != "": Rectangle {
                        height: 110px;
                        background: #0f172acc;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: #38bdf833;

                        HorizontalLayout {
                            alignment: space-between;
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 14px;
                            padding-bottom: 14px;

                            // Retail Card Price
                            if root.card_price != "": VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: root.card_label;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                    letter-spacing: 1px;
                                }
                                Text {
                                    text: root.card_price;
                                    font-size: 32px;
                                    font-weight: 900;
                                    color: #ffffff;
                                }
                            }

                            // Other Means Price (shows alone as "Todo medio de pago" if no card price)
                            if root.normal_price != "": VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: root.normal_label;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #94a3b8;
                                }
                                Text {
                                    text: root.normal_price;
                                    font-size: 24px;
                                    font-weight: 800;
                                    color: #cbd5e1;
                                }
                            }

                            // SKU & Retail Store
                            if root.sku_code != "" || root.retail_name != "": VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                if root.sku_code != "": Rectangle {
                                    background: #1e293b;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #334155;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        Text {
                                            text: "SKU: " + root.sku_code;
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: #f8fafc;
                                        }
                                    }
                                }
                                if root.retail_name != "": Text {
                                    text: root.retail_name;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #64748b;
                                    letter-spacing: 1px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // RIGHT COLUMN (Specs 5 to 8)
            Rectangle {
                width: 340px;

                VerticalLayout {
                    spacing: 12px;

                    for item in root.right_specs: SpecCard {
                        category: item.category;
                        value: item.value;
                        subvalue: item.subvalue;
                        tag: item.tag;
                        icon: item.icon;
                        accent_color: #818cf8;
                    }
                }
            }
        }
    }
}

    // MODAL 1: QUICK SETUP WIZARD (First Launch)
    if root.is_quick_setup_open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000df;

        Rectangle {
            width: 620px;
            height: 560px;
            background: #0f172a;
            border-radius: 20px;
            border-width: 1px;
            border-color: #38bdf880;

            VerticalLayout {
                padding-left: 36px;
                padding-right: 36px;
                padding-top: 30px;
                padding-bottom: 30px;
                spacing: 16px;

                Text {
                    text: "Configuración Rápida de Exhibición";
                    font-size: 22px;
                    font-weight: 800;
                    color: #ffffff;
                }

                Text {
                    text: "Ingresa los datos comerciales del equipo para iniciar el showroom en tienda.";
                    font-size: 13px;
                    color: #94a3b8;
                }

                // Auto-detect Button
                Rectangle {
                    height: 38px;
                    background: #1e293b;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #38bdf840;

                    detect_touch := TouchArea {
                        clicked => {
                            root.auto_detect_clicked();
                        }
                    }

                    Text {
                        text: "⚡ Auto-detectar Hardware del Equipo";
                        font-size: 13px;
                        font-weight: 700;
                        color: #38bdf8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Marca:"; font-size: 12px; color: #cbd5e1; }
                        brand_ed := LineEdit {
                            text: root.setup_brand;
                            placeholder-text: "Ej: ASUS, LENOVO, HP";
                            edited => { root.setup_brand = self.text; }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Modelo:"; font-size: 12px; color: #cbd5e1; }
                        model_ed := LineEdit {
                            text: root.setup_model;
                            placeholder-text: "Ej: ROG Strix G16";
                            edited => { root.setup_model = self.text; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Precio Tarjeta:"; font-size: 12px; color: #cbd5e1; }
                        cprice_ed := LineEdit {
                            text: root.setup_card_price;
                            placeholder-text: "Ej: $1.299.990";
                            edited => { root.setup_card_price = self.text; }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Precio Normal:"; font-size: 12px; color: #cbd5e1; }
                        nprice_ed := LineEdit {
                            text: root.setup_normal_price;
                            placeholder-text: "Ej: $1.349.990";
                            edited => { root.setup_normal_price = self.text; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "SKU Tienda:"; font-size: 12px; color: #cbd5e1; }
                        sku_ed := LineEdit {
                            text: root.setup_sku;
                            placeholder-text: "Ej: 8493021";
                            edited => { root.setup_sku = self.text; }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Tienda Retail:"; font-size: 12px; color: #cbd5e1; }
                        retail_ed := LineEdit {
                            text: root.setup_retail;
                            placeholder-text: "Ej: Ripley, Falabella, Paris";
                            edited => { root.setup_retail = self.text; }
                        }
                    }
                }

                // Submit button
                Rectangle {
                    height: 48px;
                    background: #0284c7;
                    border-radius: 10px;

                    TouchArea {
                        clicked => {
                            root.save_quick_setup(
                                root.setup_brand,
                                root.setup_model,
                                root.setup_card_price,
                                root.setup_normal_price,
                                root.setup_sku,
                                root.setup_retail
                            );
                        }
                    }

                    Text {
                        text: "Guardar y Comenzar Showroom";
                        font-size: 15px;
                        font-weight: 800;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // MODAL 2: ADMIN DIALOG
    if root.is_admin_open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000e6;

        Rectangle {
            width: root.is_admin_authenticated ? 840px : 480px;
            height: root.is_admin_authenticated ? 680px : 360px;
            background: #0f172a;
            border-radius: 20px;
            border-width: 1px;
            border-color: #38bdf880;

            if !root.is_admin_authenticated: VerticalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: 16px;
                alignment: center;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Acceso de Administración";
                        font-size: 20px;
                        font-weight: 800;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        background: touch_close_login.has-hover ? #ef4444 : #1e293b;
                        border-radius: 17px;
                        border-width: 1px;
                        border-color: touch_close_login.has-hover ? #f87171 : #475569;

                        touch_close_login := TouchArea {
                            clicked => {
                                root.close_admin_clicked();
                            }
                        }

                        Image {
                            width: 16px;
                            height: 16px;
                            source: @image-url("../assets/ui/close.svg");
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: "Ingresa la contraseña para configurar opciones avanzadas o salir.";
                    font-size: 13px;
                    color: #94a3b8;
                    horizontal-alignment: center;
                }

                pwd_ed := LineEdit {
                    placeholder-text: "Contraseña";
                    text: root.admin_password_input;
                    input-type: password;
                    accepted => {
                        root.check_admin_password(self.text);
                    }
                    edited => {
                        root.admin_password_input = self.text;
                    }
                }

                if root.admin_error_msg != "": Text {
                    text: root.admin_error_msg;
                    font-size: 12px;
                    color: #f87171;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        height: 42px;
                        background: #0284c7;
                        border-radius: 8px;

                        TouchArea {
                            clicked => {
                                root.check_admin_password(root.admin_password_input);
                            }
                        }

                        Text {
                            text: "Desbloquear";
                            font-size: 14px;
                            font-weight: 700;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 42px;
                        background: #1e293b;
                        border-radius: 8px;

                        TouchArea {
                            clicked => {
                                root.close_admin_clicked();
                            }
                        }

                        Text {
                            text: "Cancelar";
                            font-size: 14px;
                            color: #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.is_admin_authenticated: VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: 16px;

                // Modal Header with highly visible close button
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Panel de Control y Configuración";
                        font-size: 20px;
                        font-weight: 800;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        background: touch_close.has-hover ? #ef4444 : #1e293b;
                        border-radius: 17px;
                        border-width: 1px;
                        border-color: touch_close.has-hover ? #f87171 : #475569;

                        touch_close := TouchArea {
                            clicked => {
                                root.close_admin_clicked();
                            }
                        }

                        Image {
                            width: 16px;
                            height: 16px;
                            source: @image-url("../assets/ui/close.svg");
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Tabs Navigation Bar
                HorizontalLayout {
                    spacing: 8px;
                    height: 38px;

                    // Tab 0: Tienda
                    Rectangle {
                        background: root.admin_tab_index == 0 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 0 ? #38bdf8 : #334155;
                        TouchArea { clicked => { root.admin_tab_index = 0; } }
                        Text {
                            text: "🏪 Tienda";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tab 1: Especificaciones
                    Rectangle {
                        background: root.admin_tab_index == 1 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 1 ? #38bdf8 : #334155;
                        TouchArea { clicked => { root.admin_tab_index = 1; } }
                        Text {
                            text: "⚙️ Especificaciones";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tab 2: Videos
                    Rectangle {
                        background: root.admin_tab_index == 2 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 2 ? #38bdf8 : #334155;
                        TouchArea { clicked => { root.admin_tab_index = 2; } }
                        Text {
                            text: "🎬 Videos";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tab 3: Sistema
                    Rectangle {
                        background: root.admin_tab_index == 3 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 3 ? #38bdf8 : #334155;
                        TouchArea { clicked => { root.admin_tab_index = 3; } }
                        Text {
                            text: "🛠️ Sistema";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Tab Content Area
                VerticalLayout {
                    vertical-stretch: 1;

                    // TAB 0: TIENDA
                    if root.admin_tab_index == 0: VerticalLayout {
                        spacing: 12px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Marca del Equipo:"; font-size: 12px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_brand;
                                    placeholder-text: "Ej: ASUS, Lenovo, HP";
                                    edited => { root.cfg_brand = self.text; }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Modelo:"; font-size: 12px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_model;
                                    placeholder-text: "Ej: ROG Strix G16";
                                    edited => { root.cfg_model = self.text; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Precio Tarjeta:"; font-size: 12px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_card_price;
                                    placeholder-text: "Ej: $1.299.990";
                                    edited => { root.cfg_card_price = self.text; }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Precio Otros Medios:"; font-size: 12px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_normal_price;
                                    placeholder-text: "Ej: $1.349.990";
                                    edited => { root.cfg_normal_price = self.text; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Código SKU:"; font-size: 12px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_sku;
                                    placeholder-text: "Ej: 8493021";
                                    edited => { root.cfg_sku = self.text; }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Tienda / Retail:"; font-size: 12px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_retail;
                                    placeholder-text: "ripley, falabella, paris, default";
                                    edited => { root.cfg_retail = self.text; }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            Rectangle {
                                height: 34px;
                                width: 180px;
                                background: #1e293b;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #475569;

                                touch_reset_0 := TouchArea {
                                    clicked => {
                                        root.reset_store_defaults();
                                    }
                                }

                                states [
                                    hover when touch_reset_0.has-hover: {
                                        background: #334155;
                                        border-color: #38bdf8;
                                    }
                                ]

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Image {
                                        source: @image-url("../assets/ui/reset.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: #38bdf8;
                                        vertical-alignment: center;
                                    }
                                    Text { text: "Valores por defecto"; font-size: 12px; font-weight: 600; color: #f1f5f9; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    // TAB 1: ESPECIFICACIONES
                    if root.admin_tab_index == 1: VerticalLayout {
                        spacing: 8px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Marca del Equipo:"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_brand;
                                    placeholder-text: "Ej: ASUS, Lenovo, HP";
                                    edited => { root.cfg_brand = self.text; }
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Modelo del Equipo:"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_model;
                                    placeholder-text: "Ej: ROG Strix G16";
                                    edited => { root.cfg_model = self.text; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Procesador (CPU):"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_cpu;
                                    placeholder-text: "Auto / Vacío para sensor nativo";
                                    edited => { root.cfg_cpu = self.text; }
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Memoria RAM:"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_ram;
                                    placeholder-text: "Auto / Vacío para sensor nativo";
                                    edited => { root.cfg_ram = self.text; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Almacenamiento (SSD):"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_storage;
                                    placeholder-text: "Auto / Vacío para sensor nativo";
                                    edited => { root.cfg_storage = self.text; }
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Tarjeta Gráfica (GPU):"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_gpu;
                                    placeholder-text: "Auto / Vacío para sensor nativo";
                                    edited => { root.cfg_gpu = self.text; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Pantalla:"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_display;
                                    placeholder-text: "Auto / Vacío para sensor nativo";
                                    edited => { root.cfg_display = self.text; }
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Sistema Operativo:"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_os;
                                    placeholder-text: "Auto / Vacío para sensor nativo";
                                    edited => { root.cfg_os = self.text; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Duración Batería (Horas):"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_battery;
                                    placeholder-text: "Ej: Hasta 10 horas (o solo ingresa: 8, 10)";
                                    edited => { root.cfg_battery = self.text; }
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Otros / Conectividad:"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_others;
                                    placeholder-text: "Wi-Fi 6 / Bluetooth 5.3 / Teclado Español";
                                    edited => { root.cfg_others = self.text; }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            Rectangle {
                                height: 34px;
                                width: 180px;
                                background: #1e293b;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #475569;

                                touch_reset_1 := TouchArea {
                                    clicked => {
                                        root.reset_specs_defaults();
                                    }
                                }

                                states [
                                    hover when touch_reset_1.has-hover: {
                                        background: #334155;
                                        border-color: #38bdf8;
                                    }
                                ]

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Image {
                                        source: @image-url("../assets/ui/reset.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: #38bdf8;
                                        vertical-alignment: center;
                                    }
                                    Text { text: "Valores por defecto"; font-size: 12px; font-weight: 600; color: #f1f5f9; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    // TAB 2: VIDEOS Y BAÚL SEGURO
                    if root.admin_tab_index == 2: VerticalLayout {
                        spacing: 10px;

                        // Sección: Videos Principales
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Video Central Landing:"; font-size: 11px; color: #cbd5e1; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text: root.cfg_central_video;
                                        placeholder-text: "assets/videos/landing.mp4";
                                        edited => { root.cfg_central_video = self.text; }
                                    }
                                    Rectangle {
                                        width: 36px;
                                        height: 32px;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #475569;
                                        touch_pick_central := TouchArea {
                                            clicked => { root.pick_central_video_clicked(); }
                                        }
                                        states [
                                            hover when touch_pick_central.has-hover: {
                                                background: #0284c7;
                                                border-color: #38bdf8;
                                            }
                                        ]
                                        Text {
                                            text: "📁";
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Video Fondo Pantalla Completa:"; font-size: 11px; color: #cbd5e1; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text: root.cfg_bg_video;
                                        placeholder-text: "assets/videos/bg.mp4";
                                        edited => { root.cfg_bg_video = self.text; }
                                    }
                                    Rectangle {
                                        width: 36px;
                                        height: 32px;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #475569;
                                        touch_pick_bg := TouchArea {
                                            clicked => { root.pick_bg_video_clicked(); }
                                        }
                                        states [
                                            hover when touch_pick_bg.has-hover: {
                                                background: #0284c7;
                                                border-color: #38bdf8;
                                            }
                                        ]
                                        Text {
                                            text: "📁";
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                width: 140px;
                                spacing: 3px;
                                Text { text: "Timeout Inactividad (seg):"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_inactivity_timeout;
                                    placeholder-text: "120";
                                    edited => { root.cfg_inactivity_timeout = self.text; }
                                }
                            }
                        }

                        // Sección: 3 Slots de Inactividad (Rotación cada 2 minutos)
                        Text {
                            text: "🎬 Videos de Inactividad (Hasta 3 videos con rotación automática cada 2 min):";
                            font-size: 12px;
                            font-weight: 700;
                            color: #38bdf8;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Video Inactividad #1:"; font-size: 10px; color: #94a3b8; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text: root.cfg_inactivity_video_1;
                                        placeholder-text: "assets/videos/promo2.mp4";
                                        edited => { root.cfg_inactivity_video_1 = self.text; }
                                    }
                                    Rectangle {
                                        width: 32px;
                                        height: 30px;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #475569;
                                        touch_pick_inact1 := TouchArea {
                                            clicked => { root.pick_inactivity_1_clicked(); }
                                        }
                                        states [
                                            hover when touch_pick_inact1.has-hover: {
                                                background: #0284c7;
                                                border-color: #38bdf8;
                                            }
                                        ]
                                        Text {
                                            text: "📁";
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Video Inactividad #2:"; font-size: 10px; color: #94a3b8; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text: root.cfg_inactivity_video_2;
                                        placeholder-text: "assets/videos/promo.mp4";
                                        edited => { root.cfg_inactivity_video_2 = self.text; }
                                    }
                                    Rectangle {
                                        width: 32px;
                                        height: 30px;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #475569;
                                        touch_pick_inact2 := TouchArea {
                                            clicked => { root.pick_inactivity_2_clicked(); }
                                        }
                                        states [
                                            hover when touch_pick_inact2.has-hover: {
                                                background: #0284c7;
                                                border-color: #38bdf8;
                                            }
                                        ]
                                        Text {
                                            text: "📁";
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Video Inactividad #3:"; font-size: 10px; color: #94a3b8; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text: root.cfg_inactivity_video_3;
                                        placeholder-text: "Opcional / Vacío";
                                        edited => { root.cfg_inactivity_video_3 = self.text; }
                                    }
                                    Rectangle {
                                        width: 32px;
                                        height: 30px;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #475569;
                                        touch_pick_inact3 := TouchArea {
                                            clicked => { root.pick_inactivity_3_clicked(); }
                                        }
                                        states [
                                            hover when touch_pick_inact3.has-hover: {
                                                background: #0284c7;
                                                border-color: #38bdf8;
                                            }
                                        ]
                                        Text {
                                            text: "📁";
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Sección: Baúl Seguro de Videos
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "📦 Baúl Seguro (%APPDATA%/Zenit/vault):";
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 8px;

                                Rectangle {
                                    width: 170px;
                                    height: 32px;
                                    background: #1e293b;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #475569;

                                    touch_reset_2 := TouchArea {
                                        clicked => {
                                            root.reset_videos_defaults();
                                        }
                                    }

                                    states [
                                        hover when touch_reset_2.has-hover: {
                                            background: #334155;
                                            border-color: #38bdf8;
                                        }
                                    ]

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Image {
                                            source: @image-url("../assets/ui/reset.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: #38bdf8;
                                            vertical-alignment: center;
                                        }
                                        Text { text: "Valores por defecto"; font-size: 12px; font-weight: 600; color: #f1f5f9; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    width: 190px;
                                    height: 32px;
                                    background: #0284c7;
                                    border-radius: 6px;
                                    TouchArea {
                                        clicked => {
                                            root.import_video_to_vault_clicked();
                                        }
                                    }
                                    Text {
                                        text: "+ 📁 Importar Video...";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Lista de Videos en el Baúl con ScrollView
                        Rectangle {
                            height: 140px;
                            background: #090e1a;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #334155;
                            clip: true;

                            if root.vault_videos.length == 0: Text {
                                text: "El baúl está vacío. Haz clic en 'Importar Video' para añadir videos MP4.";
                                font-size: 12px;
                                color: #64748b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            if root.vault_videos.length > 0: ScrollView {
                                content-width: self.width;
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 6px;
                                    for item in root.vault_videos: Rectangle {
                                        height: 36px;
                                        background: #1e293b;
                                        border-radius: 6px;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;
                                                Text {
                                                    text: "🎬 " + item.name;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    color: #f1f5f9;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: "(" + item.size_str + ")";
                                                    font-size: 10px;
                                                    color: #64748b;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: end;

                                                // Asignar a Slot 1
                                                Rectangle {
                                                    width: 48px;
                                                    height: 24px;
                                                    background: #0284c7;
                                                    border-radius: 4px;
                                                    TouchArea {
                                                        clicked => {
                                                            root.cfg_inactivity_video_1 = item.path;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Slot 1";
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        color: #ffffff;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                // Asignar a Slot 2
                                                Rectangle {
                                                    width: 48px;
                                                    height: 24px;
                                                    background: #0284c7;
                                                    border-radius: 4px;
                                                    TouchArea {
                                                        clicked => {
                                                            root.cfg_inactivity_video_2 = item.path;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Slot 2";
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        color: #ffffff;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                // Asignar a Slot 3
                                                Rectangle {
                                                    width: 48px;
                                                    height: 24px;
                                                    background: #0284c7;
                                                    border-radius: 4px;
                                                    TouchArea {
                                                        clicked => {
                                                            root.cfg_inactivity_video_3 = item.path;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Slot 3";
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        color: #ffffff;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                // Eliminar
                                                Rectangle {
                                                    width: 28px;
                                                    height: 24px;
                                                    background: #ef444433;
                                                    border-radius: 4px;
                                                    TouchArea {
                                                        clicked => {
                                                            root.delete_vault_video_clicked(item.filename);
                                                        }
                                                    }
                                                    Text {
                                                        text: "🗑️";
                                                        font-size: 11px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 3: SISTEMA
                    if root.admin_tab_index == 3: VerticalLayout {
                        spacing: 14px;
                        alignment: center;

                        // Auto-detect Button
                        Rectangle {
                            height: 42px;
                            background: #0284c7;
                            border-radius: 8px;
                            TouchArea { clicked => { root.auto_detect_clicked(); } }
                            Text {
                                text: "⚡ Auto-detectar Hardware del Equipo";
                                font-size: 14px;
                                font-weight: 700;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Reset All Defaults Button
                        Rectangle {
                            height: 42px;
                            background: #1e293b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #475569;

                            touch_reset_3 := TouchArea {
                                clicked => {
                                    root.reset_system_defaults();
                                }
                            }

                            states [
                                hover when touch_reset_3.has-hover: {
                                    background: #334155;
                                    border-color: #38bdf8;
                                }
                            ]

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Image {
                                    source: @image-url("../assets/ui/reset.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: #38bdf8;
                                    vertical-alignment: center;
                                }
                                Text { text: "Valores por defecto (Restablecer Todo a Fábrica)"; font-size: 14px; font-weight: 700; color: #f1f5f9; vertical-alignment: center; }
                            }
                        }

                        // Restart App
                        Rectangle {
                            height: 42px;
                            background: #d97706;
                            border-radius: 8px;
                            TouchArea { clicked => { root.emergency_restart_clicked(); } }
                            Text {
                                text: "🔄 Reiniciar Aplicación";
                                font-size: 14px;
                                font-weight: 700;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Exit to Windows
                        Rectangle {
                            height: 42px;
                            background: #dc2626;
                            border-radius: 8px;
                            TouchArea { clicked => { root.emergency_exit_clicked(); } }
                            Text {
                                text: "🚪 Salir a Windows (Cerrar Aplicación)";
                                font-size: 14px;
                                font-weight: 700;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Modal Footer
                HorizontalLayout {
                    spacing: 12px;
                    height: 44px;

                    Rectangle {
                        background: #0284c7;
                        border-radius: 8px;

                        TouchArea {
                            clicked => {
                                root.save_admin_config(
                                    root.cfg_brand, root.cfg_model, root.cfg_retail, root.cfg_card_price, root.cfg_normal_price, root.cfg_sku,
                                    root.cfg_cpu, root.cfg_ram, root.cfg_storage, root.cfg_gpu, root.cfg_display, root.cfg_os, root.cfg_battery, root.cfg_others,
                                    root.cfg_central_video, root.cfg_bg_video, root.cfg_inactivity_video_1, root.cfg_inactivity_video_2, root.cfg_inactivity_video_3, root.cfg_inactivity_timeout
                                );
                            }
                        }

                        Text {
                            text: "💾 Guardar Cambios";
                            font-size: 14px;
                            font-weight: 700;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 120px;
                        background: #1e293b;
                        border-radius: 8px;

                        TouchArea {
                            clicked => {
                                root.close_admin_clicked();
                            }
                        }

                        Text {
                            text: "Cerrar";
                            font-size: 14px;
                            font-weight: 600;
                            color: #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // MODAL 3: SCREENSAVER OVERLAY (PANTALLA COMPLETA DE VIDEO)
    if root.is_screensaver_active: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;

        // Video a Pantalla Completa
        if root.has_video_stream: Image {
            width: 100%;
            height: 100%;
            source: root.video_frame;
            image-fit: cover;
        }

        // Cualquier toque en pantalla desactiva el salvapantallas
        TouchArea {
            clicked => {
                root.dismiss_screensaver();
            }
        }

        // Fallback cuando no hay stream de video disponible
        if !root.has_video_stream: VerticalLayout {
            alignment: center;
            spacing: 24px;

            Rectangle {
                width: 90px;
                height: 90px;
                border-radius: 45px;
                background: #0284c726;
                border-width: 2px;
                border-color: #38bdf880;

                Text {
                    text: "✨";
                    font-size: 40px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.brand_name + " " + root.model_name;
                font-size: 36px;
                font-weight: 900;
                color: #ffffff;
                horizontal-alignment: center;
            }

            Text {
                text: "Toca la pantalla o presiona cualquier tecla para interactuar";
                font-size: 16px;
                font-weight: 600;
                color: #38bdf8;
                horizontal-alignment: center;
            }
        }

        // Indicador interactivo sutil inferior
        if root.has_video_stream: VerticalLayout {
            alignment: end;
            padding-bottom: 32px;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    background: #030712b3;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: #38bdf840;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000080;
                    height: 40px;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 10px;
                        alignment: center;

                        Text {
                            text: "✨";
                            font-size: 14px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Toca la pantalla o presiona cualquier tecla para interactuar";
                            font-size: 14px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
