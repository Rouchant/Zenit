export component FloatingDetailsButton inherits Window {
    title: "Zenit - Ver Detalles";
    no-frame: true;
    always-on-top: true;
    width: 160px;
    height: 120px;
    background: transparent;

    callback restore_clicked();

    Rectangle {
        width: 100%;
        height: 100%;
        background: #E0E0E0f2;
        border-radius: 20px;
        border-width: 2px;
        border-color: #0284c7;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000026;
        drop-shadow-offset-y: 4px;
        clip: true;

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.restore_clicked();
            }
        }

        states [
            hover when touch.has-hover: {
                background: #0284c7;
                border-color: #0284c7;
            }
        ]

        VerticalLayout {
            alignment: center;
            spacing: 6px;
            padding: 12px;

            Text {
                text: "📋";
                font-size: 26px;
                horizontal-alignment: center;
            }

            Text {
                text: "Ver detalles";
                font-size: 15px;
                font-weight: 800;
                color: touch.has-hover ? #E0E0E0 : #0f172a;
                horizontal-alignment: center;
            }

            Text {
                text: "SHOWROOM";
                font-size: 10px;
                font-weight: 800;
                color: touch.has-hover ? #e0f2fe : #0284c7;
                letter-spacing: 1.2px;
                horizontal-alignment: center;
            }
        }
    }
}
