export component SpecCard inherits Rectangle {
    in property <string> category: "CATEGORÍA";
    in property <string> value: "Valor Principal";
    in property <string> subvalue: "Detalle adicional";
    in property <string> tag: "TOP";
    in property <color> accent_color: #0284c7;
    in property <color> card_bg: #F5F5F5;
    in property <color> card_border: #e2e8f0;
    in property <color> text_primary: #0f172a;
    in property <color> text_secondary: #475569;
    in property <color> category_color: #64748b;
    in property <image> icon;

    vertical-stretch: 1;
    background: root.card_bg;
    border-radius: 14px;
    border-width: 1.5px;
    border-color: root.card_border;
    clip: true;

    touch := TouchArea {}

    animate border-color { duration: 100ms; }
    animate background { duration: 100ms; }

    states [
        hover when touch.has-hover: {
            border-color: root.accent_color;
        }
    ]

    VerticalLayout {
        alignment: center;
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 8px;

        // HEADER: Icon + Category (Respira libremente sin saturación)
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            if root.icon.width > 0: Image {
                source: root.icon;
                width: 28px;
                height: 28px;
                colorize: root.accent_color;
                vertical-alignment: center;
            }

            Text {
                text: root.category;
                font-size: 14px;
                font-weight: 800;
                color: root.category_color;
                letter-spacing: 0.8px;
                vertical-alignment: center;
            }
        }

        // MAIN VALUE (Lectura rápida y prominente)
        Text {
            text: root.value;
            font-size: 19px;
            font-weight: 800;
            color: root.text_primary;
            wrap: word-wrap;
        }

        // FOOTER: Metadata Badge (Pastilla inferior) & Subvalue
        if root.tag != "" || root.subvalue != "": HorizontalLayout {
            alignment: start;
            spacing: 8px;

            if root.tag != "": Rectangle {
                height: 24px;
                background: root.card_border;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.accent_color;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;

                    Text {
                        text: root.tag;
                        font-size: 11px;
                        font-weight: 800;
                        color: root.accent_color;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            if root.subvalue != "": VerticalLayout {
                alignment: center;

                Text {
                    text: root.subvalue;
                    font-size: 13px;
                    font-weight: 600;
                    color: root.text_secondary;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
