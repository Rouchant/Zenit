export component SpecCard inherits Rectangle {
    in property <string> category: "CATEGORÍA";
    in property <string> value: "Valor Principal";
    in property <string> subvalue: "Detalle adicional";
    in property <string> tag: "TOP";
    in property <color> accent_color: #38bdf8;
    in property <image> icon;

    vertical-stretch: 1;
    background: #0f172a99;
    border-radius: 12px;
    border-width: 1px;
    border-color: #38bdf826;
    clip: true;

    touch := TouchArea {}

    animate border-color { duration: 200ms; }
    animate background { duration: 200ms; }

    states [
        hover when touch.has-hover: {
            background: #1e293bcc;
            border-color: #38bdf880;
        }
    ]

    VerticalLayout {
        alignment: center;
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 6px;

        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                if root.icon.width > 0: Image {
                    source: root.icon;
                    width: 30px;
                    height: 30px;
                    colorize: root.accent_color;
                    vertical-alignment: center;
                }

                Text {
                    text: root.category;
                    font-size: 11px;
                    font-weight: 700;
                    color: #94a3b8;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }

            if root.tag != "": VerticalLayout {
                alignment: center;

                Rectangle {
                    height: 20px;
                    background: #0369a140;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #38bdf840;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;

                        Text {
                            text: root.tag;
                            font-size: 10px;
                            font-weight: 700;
                            color: #38bdf8;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        Text {
            text: root.value;
            font-size: 16px;
            font-weight: 700;
            color: #ffffff;
            wrap: word-wrap;
        }

        if root.subvalue != "": Text {
            text: root.subvalue;
            font-size: 12px;
            color: #cbd5e1;
            wrap: word-wrap;
        }
    }
}
