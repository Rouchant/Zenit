export component SpecCard inherits Rectangle {
    in property <string> category: "CATEGORÍA";
    in property <string> value: "Valor Principal";
    in property <string> subvalue: "Detalle adicional";
    in property <string> tag: "TOP";
    in property <color> accent_color: #0284c7;
    in property <image> icon;

    vertical-stretch: 1;
    background: #ffffff;
    border-radius: 14px;
    border-width: 1px;
    border-color: #e2e8f0;
    drop-shadow-blur: 10px;
    drop-shadow-color: #0000000d;
    drop-shadow-offset-y: 2px;
    clip: true;

    touch := TouchArea {}

    animate border-color { duration: 180ms; }
    animate background { duration: 180ms; }

    states [
        hover when touch.has-hover: {
            background: #f8fafc;
            border-color: #0284c7;
        }
    ]

    VerticalLayout {
        alignment: center;
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 6px;

        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                if root.icon.width > 0: Image {
                    source: root.icon;
                    width: 28px;
                    height: 28px;
                    colorize: root.accent_color;
                    vertical-alignment: center;
                }

                Text {
                    text: root.category;
                    font-size: 11px;
                    font-weight: 700;
                    color: #64748b;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }

            if root.tag != "": VerticalLayout {
                alignment: center;

                Rectangle {
                    height: 24px;
                    background: #e0f2fe;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #bae6fd;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;

                        Text {
                            text: root.tag;
                            font-size: 12px;
                            font-weight: 800;
                            color: #0284c7;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        Text {
            text: root.value;
            font-size: 19px;
            font-weight: 800;
            color: #0f172a;
            wrap: word-wrap;
        }

        if root.subvalue != "": Text {
            text: root.subvalue;
            font-size: 13px;
            color: #475569;
            wrap: word-wrap;
        }
    }
}
