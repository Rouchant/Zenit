export struct SpecItem {
    category: string,
    value: string,
    subvalue: string,
    tag: string,
    icon: image,
}

export struct VaultVideoItem {
    name: string,
    filename: string,
    path: string,
    size_str: string,
    is_preloaded: bool,
}

export global Theme {
    out property <color> background: #f1f5f9;
    out property <color> surface: #F5F5F5;
    out property <color> card-bg: #F5F5F5;
    out property <color> card-hover: #f1f5f9;
    out property <color> primary: #0284c7;
    out property <color> primary-hover: #0369a1;
    out property <color> accent-cyan: #0284c7;
    out property <color> accent-indigo: #4f46e5;
    out property <color> text-primary: #0f172a;
    out property <color> text-secondary: #475569;
    out property <color> text-muted: #64748b;
    out property <color> border-subtle: #e2e8f0;
    out property <color> border-accent: #0284c780;
}
