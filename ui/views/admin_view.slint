import { Button, LineEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { VaultVideoItem } from "../theme.slint";

component ColorPickerInput inherits VerticalLayout {
    in property <string> label: "";
    in-out property <string> text <=> input.text;
    in property <color> preview_color: #F5F5F5;
    in property <string> field_name: "";
    callback pick_clicked(string);
    callback edited(string);

    spacing: 3px;
    Text { text: root.label; font-size: 11px; color: #cbd5e1; font-weight: 500; }
    HorizontalLayout {
        spacing: 6px;
        input := LineEdit {
            horizontal-stretch: 1;
            edited => { root.edited(self.text); }
        }
        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 6px;
            background: root.preview_color;
            border-width: 1.5px;
            border-color: swatch_touch.has-hover ? #38bdf8 : #475569;
            clip: true;

            swatch_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.pick_clicked(root.field_name);
                }
            }

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: #00000077;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                Text {
                    text: "🎨";
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component AdminView inherits Rectangle {
    in-out property <bool> is_admin_authenticated: false;
    in-out property <string> admin_password_input: "";
    in-out property <string> admin_error_msg: "";
    in-out property <int> admin_tab_index: 0;

    // Tab Tienda
    in-out property <string> cfg_brand: "";
    in-out property <string> cfg_brand_logo: "";
    in-out property <string> cfg_model: "";
    in-out property <string> cfg_retail: "";
    in-out property <string> cfg_store_logo: "";
    in-out property <string> cfg_card_price: "";
    in-out property <string> cfg_normal_price: "";
    in-out property <string> cfg_sku: "";
    property <bool> force_show_custom_retail: false;
    property <bool> is_custom_retail_active: (root.cfg_retail != "" && root.cfg_retail != "Falabella" && root.cfg_retail != "falabella" && root.cfg_retail != "Ripley" && root.cfg_retail != "ripley" && root.cfg_retail != "Paris" && root.cfg_retail != "paris") || (root.cfg_store_logo != "" && root.cfg_store_logo != "assets/logos/falabella.svg" && root.cfg_store_logo != "assets/logos/ripley.svg" && root.cfg_store_logo != "assets/logos/paris.png");
    property <bool> show_custom_retail: root.force_show_custom_retail || root.is_custom_retail_active;
    property <bool> is_preset_retail: (root.cfg_retail == "Falabella" || root.cfg_retail == "falabella" || root.cfg_retail == "Ripley" || root.cfg_retail == "ripley" || root.cfg_retail == "Paris" || root.cfg_retail == "paris");

    property <bool> force_show_custom_brand_logo: false;
    property <bool> is_custom_brand_logo_active: (root.cfg_brand_logo != "" && root.cfg_brand_logo != "assets/logos/acer.svg" && root.cfg_brand_logo != "assets/logos/asus.svg" && root.cfg_brand_logo != "assets/logos/hp.svg" && root.cfg_brand_logo != "assets/logos/lenovo.svg" && root.cfg_brand_logo != "assets/logos/samsung.svg");
    property <bool> show_custom_brand_logo: root.force_show_custom_brand_logo || root.is_custom_brand_logo_active;

    // Tab Especificaciones
    in-out property <string> cfg_cpu: "";
    in-out property <string> cfg_ram: "";
    in-out property <string> cfg_storage: "";
    in-out property <string> cfg_gpu: "";
    in-out property <string> cfg_display: "";
    in-out property <string> cfg_os: "";
    in-out property <string> cfg_battery: "";
    in-out property <string> cfg_others: "";
    in-out property <string> cfg_badge_cpu: "";
    in-out property <string> cfg_badge_ram: "";
    in-out property <string> cfg_badge_storage: "";
    in-out property <string> cfg_badge_gpu: "";
    in-out property <string> cfg_badge_display: "";
    in-out property <string> cfg_badge_os: "";
    in-out property <string> cfg_badge_battery: "";
    in-out property <string> cfg_badge_others: "";
    in-out property <string> placeholder_badge_cpu: "GEN";
    in-out property <string> placeholder_badge_ram: "RAM";
    in-out property <string> placeholder_badge_storage: "SSD";
    in-out property <string> placeholder_badge_gpu: "GPU";
    in-out property <string> placeholder_badge_display: "165Hz";
    in-out property <string> placeholder_badge_os: "";
    in-out property <string> placeholder_badge_battery: "";
    in-out property <string> placeholder_badge_others: "";

    // Tab Videos & Baúl
    in-out property <string> cfg_central_video: "";
    in-out property <string> cfg_bg_video: "";
    in-out property <string> cfg_inactivity_video_1: "";
    in-out property <string> cfg_inactivity_video_2: "";
    in-out property <string> cfg_inactivity_video_3: "";
    in-out property <string> cfg_inactivity_timeout: "120";
    in-out property <[VaultVideoItem]> vault_videos: [];

    // Tab Interfaz
    in-out property <string> cfg_bg_base: "#e3e8f5";
    in-out property <string> cfg_bg_start: "#dcedf5";
    in-out property <string> cfg_bg_mid: "#e3e8f5";
    in-out property <string> cfg_bg_end: "#eae4f5";
    in-out property <string> cfg_card_bg: "#F5F5F5";
    in-out property <string> cfg_card_border: "#e2e8f0";
    in-out property <string> cfg_text_primary: "#0f172a";
    in-out property <string> cfg_text_secondary: "#64748b";
    in-out property <string> cfg_accent: "#0284c7";
    in-out property <string> cfg_btn_bg: "#0284c7";
    in-out property <string> cfg_btn_text: "#F5F5F5";
    in-out property <bool> is_dark_mode: false;
    property <int> active_video_picker: 0;
    property <string> assigning_video_path: "";
    in-out property <bool> is_dirty: false;
    property <bool> show_discard_confirm: false;
    property <bool> show_advanced_colors: false;

    // Callbacks
    callback update_bg_base_color(string);
    callback close_admin_clicked();
    callback check_admin_password(string);
    callback emergency_exit_clicked();
    callback emergency_restart_clicked();
    callback auto_detect_clicked();
    callback format_currency_input(string) -> string;
    callback save_admin_config(
        string, string, string, string, string, string,
        string, string, string, string, string, string, string, string,
        string, string, string, string, string, string
    );
    callback import_video_to_vault_clicked();
    callback delete_vault_video_clicked(string);
    callback reset_store_defaults();
    callback reset_specs_defaults();
    callback reset_videos_defaults();
    callback reset_system_defaults();
    callback reset_ui_defaults();
    callback pick_central_video_clicked();
    callback pick_bg_video_clicked();
    callback pick_inactivity_1_clicked();
    callback pick_inactivity_2_clicked();
    callback pick_inactivity_3_clicked();
    callback pick_color_clicked(string);
    callback pick_brand_logo_clicked();
    callback pick_store_logo_clicked();
    pure callback hex_to_color(string) -> color;

    // Aviso cuando se intenta dejar el showroom sin videos
    in-out property <string> video_warning: "";
    video_warning_timer := Timer {
        interval: 3500ms;
        running: root.video_warning != "";
        triggered => { root.video_warning = ""; }
    }

    // slot: 1..3 = inactividad, 4 = landing
    function try_clear_video(slot: int) {
        if slot == 4 {
            root.video_warning = "⚠ El video de Landing no puede quedar vacío. Elige otro video para reemplazarlo.";
            return;
        }
        if (slot == 1 && root.cfg_inactivity_video_2 == "" && root.cfg_inactivity_video_3 == "")
            || (slot == 2 && root.cfg_inactivity_video_1 == "" && root.cfg_inactivity_video_3 == "")
            || (slot == 3 && root.cfg_inactivity_video_1 == "" && root.cfg_inactivity_video_2 == "") {
            root.video_warning = "⚠ Debe haber al menos 1 video de inactividad. No se puede quitar el último.";
            return;
        }
        if slot == 1 { root.cfg_inactivity_video_1 = ""; }
        if slot == 2 { root.cfg_inactivity_video_2 = ""; }
        if slot == 3 { root.cfg_inactivity_video_3 = ""; }
    }

    width: 100%;
    height: 100%;
    background: #000000e6;

        Rectangle {
            width: root.is_admin_authenticated ? 840px : 480px;
            height: root.is_admin_authenticated ? 680px : 360px;
            background: #0f172a;
            border-radius: 20px;
            border-width: 1px;
            border-color: #38bdf880;

            if !root.is_admin_authenticated: VerticalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: 16px;
                alignment: center;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Acceso de Administración";
                        font-size: 20px;
                        font-weight: 800;
                        color: #F5F5F5;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        background: touch_close_login.has-hover ? #ef4444 : #1e293b;
                        border-radius: 17px;
                        border-width: 1px;
                        border-color: touch_close_login.has-hover ? #f87171 : #475569;

                        touch_close_login := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close_admin_clicked();
                            }
                        }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/ui/close.svg");
                        }
                    }
                }

                Text {
                    text: "Ingresa la contraseña para configurar opciones avanzadas o salir.";
                    font-size: 13px;
                    color: #94a3b8;
                    horizontal-alignment: center;
                }

                pwd_ed := LineEdit {
                    placeholder-text: "Contraseña";
                    text: root.admin_password_input;
                    input-type: password;
                    accepted => {
                        root.check_admin_password(self.text);
                    }
                    edited => {
                        root.admin_password_input = self.text;
                    }
                }

                if root.admin_error_msg != "": Text {
                    text: root.admin_error_msg;
                    font-size: 12px;
                    color: #f87171;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        height: 42px;
                        background: #0284c7;
                        border-radius: 8px;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.check_admin_password(root.admin_password_input);
                            }
                        }

                        Text {
                            text: "Desbloquear";
                            font-size: 14px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 42px;
                        background: #1e293b;
                        border-radius: 8px;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close_admin_clicked();
                            }
                        }

                        Text {
                            text: "Cancelar";
                            font-size: 14px;
                            color: #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.is_admin_authenticated: VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: 16px;

                // Modal Header with highly visible close button
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Panel de Control y Configuración";
                        font-size: 20px;
                        font-weight: 800;
                        color: #F5F5F5;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        background: touch_close.has-hover ? #ef4444 : #1e293b;
                        border-radius: 17px;
                        border-width: 1px;
                        border-color: touch_close.has-hover ? #f87171 : #475569;

                        touch_close := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if root.is_dirty {
                                    root.show_discard_confirm = true;
                                } else {
                                    root.close_admin_clicked();
                                }
                            }
                        }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/ui/close.svg");
                        }
                    }
                }

                // Tabs Navigation Bar
                HorizontalLayout {
                    spacing: 8px;
                    height: 38px;

                    // Tab 0: Tienda
                    Rectangle {
                        background: root.admin_tab_index == 0 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 0 ? #38bdf8 : #334155;
                        TouchArea { mouse-cursor: pointer; clicked => { root.admin_tab_index = 0; } }
                        Text {
                            text: "🏪 Tienda";
                            font-size: 13px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tab 1: Especificaciones
                    Rectangle {
                        background: root.admin_tab_index == 1 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 1 ? #38bdf8 : #334155;
                        TouchArea { mouse-cursor: pointer; clicked => { root.admin_tab_index = 1; } }
                        Text {
                            text: "⚙️ Especificaciones";
                            font-size: 13px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tab 2: Videos
                    Rectangle {
                        background: root.admin_tab_index == 2 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 2 ? #38bdf8 : #334155;
                        TouchArea { mouse-cursor: pointer; clicked => { root.admin_tab_index = 2; } }
                        Text {
                            text: "🎬 Videos";
                            font-size: 13px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tab 3: Interfaz
                    Rectangle {
                        background: root.admin_tab_index == 3 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 3 ? #38bdf8 : #334155;
                        TouchArea { mouse-cursor: pointer; clicked => { root.admin_tab_index = 3; } }
                        Text {
                            text: "🎨 Interfaz";
                            font-size: 13px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tab 4: Sistema
                    Rectangle {
                        background: root.admin_tab_index == 4 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 4 ? #38bdf8 : #334155;
                        TouchArea { mouse-cursor: pointer; clicked => { root.admin_tab_index = 4; } }
                        Text {
                            text: "🛠️ Sistema";
                            font-size: 13px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Tab Content Area
                VerticalLayout {
                    vertical-stretch: 1;

                    // TAB 0: TIENDA
                    if root.admin_tab_index == 0: VerticalLayout {
                        spacing: 16px;
                        alignment: start;

                        // Logo de Marca (Aparece sobre el video central)
                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Logo de Marca (aparece arriba del video):"; font-size: 11px; color: #cbd5e1; }
                                Text { text: "Selecciona una marca de la lista o añade un archivo:"; font-size: 11px; color: #38bdf8; }
                            }

                            // Selector desplegable y explorador de archivos
                            HorizontalLayout {
                                spacing: 10px;

                                ComboBox {
                                    width: root.show_custom_brand_logo ? 190px : 260px;
                                    height: 32px;
                                    model: [
                                        "Auto (Hardware)",
                                        "Acer",
                                        "ASUS",
                                        "HP",
                                        "Lenovo",
                                        "Samsung",
                                        "Personalizado..."
                                    ];
                                    current-value: (root.cfg_brand_logo == "assets/logos/acer.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "Acer")) ? "Acer" :
                                                   (root.cfg_brand_logo == "assets/logos/asus.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "ASUS")) ? "ASUS" :
                                                   (root.cfg_brand_logo == "assets/logos/hp.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "HP")) ? "HP" :
                                                   (root.cfg_brand_logo == "assets/logos/lenovo.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "Lenovo")) ? "Lenovo" :
                                                   (root.cfg_brand_logo == "assets/logos/samsung.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "Samsung")) ? "Samsung" :
                                                   (root.cfg_brand_logo == "") ? "Auto (Hardware)" :
                                                   "Personalizado...";
                                    selected(val) => {
                                        if val == "Auto (Hardware)" {
                                            root.cfg_brand_logo = "";
                                            root.force_show_custom_brand_logo = false;
                                        } else if val == "Acer" {
                                            root.cfg_brand_logo = "assets/logos/acer.svg";
                                            root.force_show_custom_brand_logo = false;
                                        } else if val == "ASUS" {
                                            root.cfg_brand_logo = "assets/logos/asus.svg";
                                            root.force_show_custom_brand_logo = false;
                                        } else if val == "HP" {
                                            root.cfg_brand_logo = "assets/logos/hp.svg";
                                            root.force_show_custom_brand_logo = false;
                                        } else if val == "Lenovo" {
                                            root.cfg_brand_logo = "assets/logos/lenovo.svg";
                                            root.force_show_custom_brand_logo = false;
                                        } else if val == "Samsung" {
                                            root.cfg_brand_logo = "assets/logos/samsung.svg";
                                            root.force_show_custom_brand_logo = false;
                                        } else if val == "Personalizado..." {
                                            root.force_show_custom_brand_logo = true;
                                            root.pick_brand_logo_clicked();
                                        }
                                    }
                                }

                                if !root.show_custom_brand_logo: HorizontalLayout {
                                    horizontal-stretch: 1;
                                    alignment: start;
                                    spacing: 8px;
                                    Text {
                                        text: (root.cfg_brand_logo == "" ? "✓ Logo detectado automáticamente por hardware" : "✓ Logo oficial aplicado");
                                        font-size: 11px;
                                        color: #38bdf8;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.show_custom_brand_logo: LineEdit {
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    text: root.cfg_brand_logo;
                                    placeholder-text: "assets/logos/... o ruta de imagen personalizada (SVG, PNG)";
                                    edited => { root.cfg_brand_logo = self.text; }
                                }

                                if root.show_custom_brand_logo: Rectangle {
                                    width: 130px;
                                    height: 32px;
                                    background: #1e293b;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #475569;
                                    touch_pick_brand_logo := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.pick_brand_logo_clicked(); }
                                    }
                                    states [
                                        hover when touch_pick_brand_logo.has-hover: {
                                            background: #0284c7;
                                            border-color: #38bdf8;
                                        }
                                    ]
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Text { text: "📁"; font-size: 13px; vertical-alignment: center; }
                                        Text { text: "Añadir Logo"; font-size: 11px; font-weight: 600; color: #F5F5F5; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                width: 386px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    if (root.cfg_retail == "falabella" || root.cfg_retail == "Falabella"): Image {
                                        source: @image-url("../../assets/images/T-FALABELLA.svg");
                                        width: 25px;
                                        height: 16px;
                                        image-fit: contain;
                                        horizontal-stretch: 0;
                                        vertical-alignment: center;
                                    }
                                    if (root.cfg_retail == "ripley" || root.cfg_retail == "Ripley"): Image {
                                        source: @image-url("../../assets/images/T-RIPLEY.svg");
                                        width: 25px;
                                        height: 16px;
                                        image-fit: contain;
                                        horizontal-stretch: 0;
                                        vertical-alignment: center;
                                    }
                                    if (root.cfg_retail == "paris" || root.cfg_retail == "Paris"): Image {
                                        source: @image-url("../../assets/images/T-CENCOSUD.svg");
                                        width: 25px;
                                        height: 16px;
                                        image-fit: contain;
                                        horizontal-stretch: 0;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: (root.cfg_retail == "falabella" || root.cfg_retail == "Falabella") ? "Precio CMR / Débito Falabella:" :
                                              (root.cfg_retail == "ripley" || root.cfg_retail == "Ripley") ? "Precio Tarjeta Banco Ripley:" :
                                              (root.cfg_retail == "paris" || root.cfg_retail == "Paris") ? "Precio Tarjeta Cencosud:" :
                                              "Precio Tarjeta:";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #cbd5e1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        min-width: 0;
                                        horizontal-stretch: 1;
                                    }
                                }
                                LineEdit {
                                    min-width: 0;
                                    text: root.cfg_card_price;
                                    placeholder-text: "$000.000...";
                                    font-italic: self.text == "";
                                    edited => {
                                        root.is_dirty = true;
                                        root.cfg_card_price = self.text;
                                    }
                                    accepted => {
                                        root.is_dirty = true;
                                        root.cfg_card_price = root.format_currency_input(self.text);
                                        self.text = root.cfg_card_price;
                                    }
                                }
                            }
                            VerticalLayout {
                                width: 386px;
                                spacing: 4px;
                                Text { text: "Precio Otros Medios:"; font-size: 12px; color: #cbd5e1; }
                                LineEdit {
                                    min-width: 0;
                                    text: root.cfg_normal_price;
                                    placeholder-text: "$000.000...";
                                    font-italic: self.text == "";
                                    edited => {
                                        root.is_dirty = true;
                                        root.cfg_normal_price = self.text;
                                    }
                                    accepted => {
                                        root.is_dirty = true;
                                        root.cfg_normal_price = root.format_currency_input(self.text);
                                        self.text = root.cfg_normal_price;
                                    }
                                }
                            }
                        }

                        // Tienda / Retail y Logo de Tienda
                        VerticalLayout {
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Tienda / Retail y Logo:";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #cbd5e1;
                                }
                                Text {
                                    text: "Selecciona una tienda de la lista desplegable o personaliza:";
                                    font-size: 11px;
                                    color: #38bdf8;
                                }
                            }

                            // Fila 1: Selector Tienda + Código SKU (2 columnas iguales que nunca desbordan)
                            HorizontalLayout {
                                spacing: 12px;

                                VerticalLayout {
                                    width: 386px;
                                    spacing: 4px;
                                    Text { text: "Seleccionar Tienda:"; font-size: 11px; color: #94a3b8; }
                                    ComboBox {
                                        min-width: 0;
                                        height: 32px;
                                        model: [
                                            "Predeterminada",
                                            "Falabella",
                                            "Ripley",
                                            "Paris",
                                            "Otra Tienda..."
                                        ];
                                        current-value: (root.cfg_retail == "falabella" || root.cfg_retail == "Falabella" || root.cfg_store_logo == "assets/logos/falabella.svg") ? "Falabella" :
                                                       (root.cfg_retail == "ripley" || root.cfg_retail == "Ripley" || root.cfg_store_logo == "assets/logos/ripley.svg") ? "Ripley" :
                                                       (root.cfg_retail == "paris" || root.cfg_retail == "Paris" || root.cfg_store_logo == "assets/logos/paris.png" || root.cfg_store_logo == "assets/logos/paris.svg") ? "Paris" :
                                                       (root.cfg_retail == "" && root.cfg_store_logo == "") ? "Predeterminada" :
                                                       "Otra Tienda...";
                                        selected(val) => {
                                            if val == "Predeterminada" {
                                                root.cfg_retail = "";
                                                root.cfg_store_logo = "";
                                                root.force_show_custom_retail = false;
                                            } else if val == "Falabella" {
                                                root.cfg_retail = "Falabella";
                                                root.cfg_store_logo = "assets/logos/falabella.svg";
                                                root.force_show_custom_retail = false;
                                            } else if val == "Ripley" {
                                                root.cfg_retail = "Ripley";
                                                root.cfg_store_logo = "assets/logos/ripley.svg";
                                                root.force_show_custom_retail = false;
                                            } else if val == "Paris" {
                                                root.cfg_retail = "Paris";
                                                root.cfg_store_logo = "assets/logos/paris.png";
                                                root.force_show_custom_retail = false;
                                            } else if val == "Otra Tienda..." {
                                                root.force_show_custom_retail = true;
                                                if root.is_preset_retail {
                                                    root.cfg_retail = "";
                                                    root.cfg_store_logo = "";
                                                }
                                                root.pick_store_logo_clicked();
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    width: 386px;
                                    spacing: 4px;
                                    Text { text: "Código SKU:"; font-size: 11px; color: #94a3b8; }
                                    LineEdit {
                                        min-width: 0;
                                        height: 32px;
                                        text: root.cfg_sku;
                                        placeholder-text: "000000...";
                                        font-italic: self.text == "";
                                        edited => { root.cfg_sku = self.text; }
                                    }
                                }
                            }

                            // Mensaje informativo para presets oficiales (en su propia fila, sin empujar el SKU)
                            if !root.show_custom_retail && root.is_preset_retail: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: "✓ Logotipo oficial de " + root.cfg_retail + " aplicado automáticamente";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #38bdf8;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.force_show_custom_retail = true;
                                    }
                                    Text {
                                        text: "(Personalizar logo...)";
                                        font-size: 11px;
                                        color: #94a3b8;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Campos de personalización para 'Otra Tienda...'
                            if root.show_custom_retail: VerticalLayout {
                                spacing: 8px;

                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "Nombre de Tienda (Personalizado):"; font-size: 11px; color: #94a3b8; }
                                    LineEdit {
                                        height: 32px;
                                        text: root.cfg_retail;
                                        placeholder-text: "Ej. PC Factory, Lider...";
                                        font-italic: self.text == "";
                                        edited => { root.cfg_retail = self.text; }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        text: root.cfg_store_logo;
                                        placeholder-text: "Ruta de logo SVG/PNG personalizado...";
                                        edited => { root.cfg_store_logo = self.text; }
                                    }
                                    Rectangle {
                                        width: 165px;
                                        height: 32px;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #475569;
                                        touch_pick_store_logo := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.pick_store_logo_clicked(); }
                                        }
                                        states [
                                            hover when touch_pick_store_logo.has-hover: {
                                                background: #0284c7;
                                                border-color: #38bdf8;
                                            }
                                        ]
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text { text: "📁"; font-size: 13px; vertical-alignment: center; }
                                            Text { text: "Subir Logo Tienda..."; font-size: 11px; font-weight: 700; color: #F5F5F5; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            Rectangle {
                                height: 34px;
                                width: 180px;
                                background: #1e293b;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #475569;

                                touch_reset_0 := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.reset_store_defaults();
                                    }
                                }

                                states [
                                    hover when touch_reset_0.has-hover: {
                                        background: #334155;
                                        border-color: #38bdf8;
                                    }
                                ]

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../../assets/ui/reset.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: #38bdf8;
                                        }
                                    }
                                    Text { text: "Valores por defecto"; font-size: 12px; font-weight: 600; color: #f1f5f9; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    // TAB 1: ESPECIFICACIONES
                    if root.admin_tab_index == 1: VerticalLayout {
                        spacing: 12px;
                        alignment: start;

                        // 2 Columns Layout: Left and Right
                        HorizontalLayout {
                            spacing: 16px;

                            // LEFT COLUMN: Marca, Procesador, RAM, SSD, GPU
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 10px;

                                // 1. Marca
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "Marca del Equipo (Badge):"; font-size: 11px; font-weight: 600; color: #cbd5e1; height: 16px; }
                                    LineEdit {
                                        min-width: 0;
                                        height: 34px;
                                        text <=> root.cfg_brand;
                                        placeholder-text: "Ej: ASUS, HP, Lenovo";
                                        edited => {
                                            root.is_dirty = true;
                                            root.cfg_brand = self.text;
                                        }
                                    }
                                }

                                // 2. Procesador
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 16px;
                                        spacing: 6px;
                                        Text { text: "Procesador (CPU):"; font-size: 11px; font-weight: 600; color: #cbd5e1; horizontal-stretch: 1; }
                                        Text { text: "Badge:"; font-size: 11px; font-weight: 600; color: #94a3b8; min-width: 120px; max-width: 120px; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit {
                                            min-width: 0;
                                            horizontal-stretch: 1;
                                            height: 34px;
                                            text <=> root.cfg_cpu;
                                            placeholder-text: "Auto (sensor nativo)";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_cpu = self.text;
                                            }
                                        }
                                        LineEdit {
                                            min-width: 120px;
                                            max-width: 120px;
                                            horizontal-stretch: 0;
                                            height: 34px;
                                            text <=> root.cfg_badge_cpu;
                                            placeholder-text: "Ej: 13va Gen";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_badge_cpu = self.text;
                                            }
                                        }
                                    }
                                }

                                // 3. RAM
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 16px;
                                        spacing: 6px;
                                        Text { text: "Memoria RAM:"; font-size: 11px; font-weight: 600; color: #cbd5e1; horizontal-stretch: 1; }
                                        Text { text: "Badge:"; font-size: 11px; font-weight: 600; color: #94a3b8; min-width: 120px; max-width: 120px; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit {
                                            min-width: 0;
                                            horizontal-stretch: 1;
                                            height: 34px;
                                            text <=> root.cfg_ram;
                                            placeholder-text: "Auto (sensor nativo)";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_ram = self.text;
                                            }
                                        }
                                        LineEdit {
                                            min-width: 120px;
                                            max-width: 120px;
                                            horizontal-stretch: 0;
                                            height: 34px;
                                            text <=> root.cfg_badge_ram;
                                            placeholder-text: "Ej: DDR5";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_badge_ram = self.text;
                                            }
                                        }
                                    }
                                }

                                // 4. Almacenamiento (SSD)
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 16px;
                                        spacing: 6px;
                                        Text { text: "Almacenamiento (SSD):"; font-size: 11px; font-weight: 600; color: #cbd5e1; horizontal-stretch: 1; }
                                        Text { text: "Badge:"; font-size: 11px; font-weight: 600; color: #94a3b8; min-width: 120px; max-width: 120px; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit {
                                            min-width: 0;
                                            horizontal-stretch: 1;
                                            height: 34px;
                                            text <=> root.cfg_storage;
                                            placeholder-text: "Auto (sensor nativo)";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_storage = self.text;
                                            }
                                        }
                                        LineEdit {
                                            min-width: 120px;
                                            max-width: 120px;
                                            horizontal-stretch: 0;
                                            height: 34px;
                                            text <=> root.cfg_badge_storage;
                                            placeholder-text: "Ej: NVMe";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_badge_storage = self.text;
                                            }
                                        }
                                    }
                                }

                                // 5. GPU
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 16px;
                                        spacing: 6px;
                                        Text { text: "Tarjeta Gráfica (GPU):"; font-size: 11px; font-weight: 600; color: #cbd5e1; horizontal-stretch: 1; }
                                        Text { text: "Badge:"; font-size: 11px; font-weight: 600; color: #94a3b8; min-width: 120px; max-width: 120px; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit {
                                            min-width: 0;
                                            horizontal-stretch: 1;
                                            height: 34px;
                                            text <=> root.cfg_gpu;
                                            placeholder-text: "Auto (sensor nativo)";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_gpu = self.text;
                                            }
                                        }
                                        LineEdit {
                                            min-width: 120px;
                                            max-width: 120px;
                                            horizontal-stretch: 0;
                                            height: 34px;
                                            text <=> root.cfg_badge_gpu;
                                            placeholder-text: "Ej: RTX / 140W";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_badge_gpu = self.text;
                                            }
                                        }
                                    }
                                }
                            }

                            // RIGHT COLUMN: Modelo, Pantalla, Batería, Otros, Windows
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 10px;

                                // 1. Modelo
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "Modelo del Equipo (Texto):"; font-size: 11px; font-weight: 600; color: #cbd5e1; height: 16px; }
                                    LineEdit {
                                        min-width: 0;
                                        height: 34px;
                                        text <=> root.cfg_model;
                                        placeholder-text: "Ej: ROG Strix G16, B550M Pro4";
                                        edited => {
                                            root.is_dirty = true;
                                            root.cfg_model = self.text;
                                        }
                                    }
                                }

                                // 2. Pantalla
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 16px;
                                        spacing: 6px;
                                        Text { text: "Pantalla:"; font-size: 11px; font-weight: 600; color: #cbd5e1; horizontal-stretch: 1; }
                                        Text { text: "Badge:"; font-size: 11px; font-weight: 600; color: #94a3b8; min-width: 120px; max-width: 120px; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit {
                                            min-width: 0;
                                            horizontal-stretch: 1;
                                            height: 34px;
                                            text <=> root.cfg_display;
                                            placeholder-text: "Auto (sensor nativo)";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_display = self.text;
                                            }
                                        }
                                        LineEdit {
                                            min-width: 120px;
                                            max-width: 120px;
                                            horizontal-stretch: 0;
                                            height: 34px;
                                            text <=> root.cfg_badge_display;
                                            placeholder-text: "Ej: OLED 120Hz";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_badge_display = self.text;
                                            }
                                        }
                                    }
                                }

                                // 3. Batería
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 16px;
                                        spacing: 6px;
                                        Text { text: "Duración Batería (Horas):"; font-size: 11px; font-weight: 600; color: #cbd5e1; horizontal-stretch: 1; }
                                        Text { text: "Badge:"; font-size: 11px; font-weight: 600; color: #94a3b8; min-width: 120px; max-width: 120px; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit {
                                            min-width: 0;
                                            horizontal-stretch: 1;
                                            height: 34px;
                                            text <=> root.cfg_battery;
                                            placeholder-text: "Ej: Hasta 8 horas o 8";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_battery = self.text;
                                            }
                                        }
                                        LineEdit {
                                            min-width: 120px;
                                            max-width: 120px;
                                            horizontal-stretch: 0;
                                            height: 34px;
                                            text <=> root.cfg_badge_battery;
                                            placeholder-text: "Ej: Opcional";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_badge_battery = self.text;
                                            }
                                        }
                                    }
                                }

                                // 4. Otros / Conectividad
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 16px;
                                        spacing: 6px;
                                        Text { text: "Otros / Conectividad:"; font-size: 11px; font-weight: 600; color: #cbd5e1; horizontal-stretch: 1; }
                                        Text { text: "Badge:"; font-size: 11px; font-weight: 600; color: #94a3b8; min-width: 120px; max-width: 120px; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit {
                                            min-width: 0;
                                            horizontal-stretch: 1;
                                            height: 34px;
                                            text <=> root.cfg_others;
                                            placeholder-text: "Ej: Wi-Fi 6 / BT 5.3";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_others = self.text;
                                            }
                                        }
                                        LineEdit {
                                            min-width: 120px;
                                            max-width: 120px;
                                            horizontal-stretch: 0;
                                            height: 34px;
                                            text <=> root.cfg_badge_others;
                                            placeholder-text: "Ej: Wi-Fi 6E";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_badge_others = self.text;
                                            }
                                        }
                                    }
                                }

                                // 5. Sistema Operativo
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 16px;
                                        spacing: 6px;
                                        Text { text: "Sistema Operativo:"; font-size: 11px; font-weight: 600; color: #cbd5e1; horizontal-stretch: 1; }
                                        Text { text: "Badge:"; font-size: 11px; font-weight: 600; color: #94a3b8; min-width: 120px; max-width: 120px; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit {
                                            min-width: 0;
                                            horizontal-stretch: 1;
                                            height: 34px;
                                            text <=> root.cfg_os;
                                            placeholder-text: "Auto (sensor nativo)";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_os = self.text;
                                            }
                                        }
                                        LineEdit {
                                            min-width: 120px;
                                            max-width: 120px;
                                            horizontal-stretch: 0;
                                            height: 34px;
                                            text <=> root.cfg_badge_os;
                                            placeholder-text: "Ej: Pro / Home";
                                            font-italic: self.text == "";
                                            edited => {
                                                root.is_dirty = true;
                                                root.cfg_badge_os = self.text;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Row 6: Botón Valores por Defecto
                        HorizontalLayout {
                            alignment: end;
                            padding-top: 4px;
                            Rectangle {
                                height: 36px;
                                width: 180px;
                                background: #1e293b;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #475569;

                                touch_reset_1 := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.is_dirty = true;
                                        root.reset_specs_defaults();
                                    }
                                }

                                states [
                                    hover when touch_reset_1.has-hover: {
                                        background: #334155;
                                        border-color: #38bdf8;
                                    }
                                ]

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../../assets/ui/reset.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: #38bdf8;
                                        }
                                    }
                                    Text { text: "Valores por defecto"; font-size: 12px; font-weight: 600; color: #f1f5f9; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    // TAB 2: VIDEOS Y BAÚL SEGURO
                    if root.admin_tab_index == 2: VerticalLayout {
                        spacing: 12px;
                        alignment: start;

                        // Sección: Videos Principales
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                width: 612px;
                                spacing: 4px;
                                Text { text: "Video Central Landing:"; font-size: 11px; color: #cbd5e1; }
                                HorizontalLayout {
                                    min-width: 0;
                                    spacing: 6px;
                                    height: 34px;
                                    Rectangle {
                                        min-width: 0;
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: touch_slot_central.has-hover ? #38bdf8 : #475569;
                                        clip: true;

                                        touch_slot_central := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.active_video_picker = 4;
                                            }
                                        }

                                        HorizontalLayout {
                                            min-width: 0;
                                            padding-left: 10px;
                                            padding-right: 8px;
                                            spacing: 6px;

                                            Text {
                                                text: "🎬";
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 0;
                                            }
                                            Text {
                                                text: root.cfg_central_video != "" ? root.cfg_central_video : "assets/videos/generic/landing-generic.mp4";
                                                font-size: 11px;
                                                color: root.cfg_central_video != "" ? #F5F5F5 : #64748b;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                min-width: 0;
                                                horizontal-stretch: 1;
                                            }

                                            if root.cfg_central_video != "": Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                horizontal-stretch: 0;
                                                background: touch_clear_central.has-hover ? #ef444433 : #00000000;

                                                touch_clear_central := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.try_clear_video(4);
                                                    }
                                                }

                                                Image {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 10px;
                                                    height: 10px;
                                                    source: @image-url("../../assets/ui/close.svg");
                                                    colorize: touch_clear_central.has-hover ? #ef4444 : #94a3b8;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 36px;
                                        height: 34px;
                                        horizontal-stretch: 0;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #475569;
                                        touch_pick_central := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.pick_central_video_clicked(); }
                                        }
                                        states [
                                            hover when touch_pick_central.has-hover: {
                                                background: #0284c7;
                                                border-color: #38bdf8;
                                            }
                                        ]
                                        Text {
                                            text: "📁";
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                width: 160px;
                                spacing: 4px;
                                alignment: start;
                                Text { text: "Timeout Inactividad (seg):"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    height: 34px;
                                    text: root.cfg_inactivity_timeout;
                                    placeholder-text: "120";
                                    edited => { root.cfg_inactivity_timeout = self.text; }
                                }
                            }
                        }

                        // Sección: 3 Slots de Inactividad (Rotación cada 2 minutos)
                        Text {
                            text: "🎬 Videos de Inactividad (Hasta 3 videos con rotación automática cada 2 min):";
                            font-size: 12px;
                            font-weight: 700;
                            color: #38bdf8;
                        }

                        if root.video_warning != "": Rectangle {
                            height: 32px;
                            background: #f59e0b22;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #f59e0b;
                            Text {
                                text: root.video_warning;
                                font-size: 12px;
                                font-weight: 700;
                                color: #fbbf24;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            // Slot 1
                            VerticalLayout {
                                width: 254px;
                                spacing: 4px;
                                Text { text: "Video Inactividad #1:"; font-size: 10px; color: #94a3b8; }
                                HorizontalLayout {
                                    min-width: 0;
                                    spacing: 6px;
                                    height: 34px;
                                    Rectangle {
                                        min-width: 0;
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: touch_slot1.has-hover ? #38bdf8 : #475569;
                                        clip: true;

                                        touch_slot1 := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.active_video_picker = 1;
                                            }
                                        }

                                        HorizontalLayout {
                                            min-width: 0;
                                            padding-left: 10px;
                                            padding-right: 6px;
                                            spacing: 6px;

                                            Text {
                                                text: "🎬";
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 0;
                                            }
                                            Text {
                                                text: root.cfg_inactivity_video_1 != "" ? root.cfg_inactivity_video_1 : "Toca para elegir video...";
                                                font-size: 11px;
                                                color: root.cfg_inactivity_video_1 != "" ? #F5F5F5 : #64748b;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                min-width: 0;
                                                horizontal-stretch: 1;
                                            }

                                            if root.cfg_inactivity_video_1 != "": Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                horizontal-stretch: 0;
                                                background: touch_clear1.has-hover ? #ef444433 : #00000000;

                                                touch_clear1 := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.try_clear_video(1);
                                                    }
                                                }

                                                Image {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 10px;
                                                    height: 10px;
                                                    source: @image-url("../../assets/ui/close.svg");
                                                    colorize: touch_clear1.has-hover ? #ef4444 : #94a3b8;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        horizontal-stretch: 0;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #475569;
                                        touch_pick_inact1 := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.pick_inactivity_1_clicked(); }
                                        }
                                        states [
                                            hover when touch_pick_inact1.has-hover: {
                                                background: #0284c7;
                                                border-color: #38bdf8;
                                            }
                                        ]
                                        Text {
                                            text: "📁";
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Slot 2
                            VerticalLayout {
                                width: 254px;
                                spacing: 4px;
                                Text { text: "Video Inactividad #2:"; font-size: 10px; color: #94a3b8; }
                                HorizontalLayout {
                                    min-width: 0;
                                    spacing: 6px;
                                    height: 34px;
                                    Rectangle {
                                        min-width: 0;
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: touch_slot2.has-hover ? #38bdf8 : #475569;
                                        clip: true;

                                        touch_slot2 := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.active_video_picker = 2;
                                            }
                                        }

                                        HorizontalLayout {
                                            min-width: 0;
                                            padding-left: 10px;
                                            padding-right: 6px;
                                            spacing: 6px;

                                            Text {
                                                text: "🎬";
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 0;
                                            }
                                            Text {
                                                text: root.cfg_inactivity_video_2 != "" ? root.cfg_inactivity_video_2 : "Toca para elegir video...";
                                                font-size: 11px;
                                                color: root.cfg_inactivity_video_2 != "" ? #F5F5F5 : #64748b;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                min-width: 0;
                                                horizontal-stretch: 1;
                                            }

                                            if root.cfg_inactivity_video_2 != "": Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                horizontal-stretch: 0;
                                                background: touch_clear2.has-hover ? #ef444433 : #00000000;

                                                touch_clear2 := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.try_clear_video(2);
                                                    }
                                                }

                                                Image {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 10px;
                                                    height: 10px;
                                                    source: @image-url("../../assets/ui/close.svg");
                                                    colorize: touch_clear2.has-hover ? #ef4444 : #94a3b8;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        horizontal-stretch: 0;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #475569;
                                        touch_pick_inact2 := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.pick_inactivity_2_clicked(); }
                                        }
                                        states [
                                            hover when touch_pick_inact2.has-hover: {
                                                background: #0284c7;
                                                border-color: #38bdf8;
                                            }
                                        ]
                                        Text {
                                            text: "📁";
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Slot 3
                            VerticalLayout {
                                width: 254px;
                                spacing: 4px;
                                Text { text: "Video Inactividad #3:"; font-size: 10px; color: #94a3b8; }
                                HorizontalLayout {
                                    min-width: 0;
                                    spacing: 6px;
                                    height: 34px;
                                    Rectangle {
                                        min-width: 0;
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: touch_slot3.has-hover ? #38bdf8 : #475569;
                                        clip: true;

                                        touch_slot3 := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.active_video_picker = 3;
                                            }
                                        }

                                        HorizontalLayout {
                                            min-width: 0;
                                            padding-left: 10px;
                                            padding-right: 6px;
                                            spacing: 6px;

                                            Text {
                                                text: "🎬";
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 0;
                                            }
                                            Text {
                                                text: root.cfg_inactivity_video_3 != "" ? root.cfg_inactivity_video_3 : "Opcional / Vacío";
                                                font-size: 11px;
                                                color: root.cfg_inactivity_video_3 != "" ? #F5F5F5 : #64748b;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                min-width: 0;
                                                horizontal-stretch: 1;
                                            }

                                            if root.cfg_inactivity_video_3 != "": Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                horizontal-stretch: 0;
                                                background: touch_clear3.has-hover ? #ef444433 : #00000000;

                                                touch_clear3 := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.try_clear_video(3);
                                                    }
                                                }

                                                Image {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 10px;
                                                    height: 10px;
                                                    source: @image-url("../../assets/ui/close.svg");
                                                    colorize: touch_clear3.has-hover ? #ef4444 : #94a3b8;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        horizontal-stretch: 0;
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #475569;
                                        touch_pick_inact3 := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.pick_inactivity_3_clicked(); }
                                        }
                                        states [
                                            hover when touch_pick_inact3.has-hover: {
                                                background: #0284c7;
                                                border-color: #38bdf8;
                                            }
                                        ]
                                        Text {
                                            text: "📁";
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Sección: Baúl Seguro de Videos
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "📦 Baúl Seguro (%APPDATA%/Zenit/vault):";
                                font-size: 12px;
                                font-weight: 700;
                                color: #F5F5F5;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 8px;

                                Rectangle {
                                    width: 170px;
                                    height: 32px;
                                    background: #1e293b;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #475569;

                                    touch_reset_2 := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.reset_videos_defaults();
                                        }
                                    }

                                    states [
                                        hover when touch_reset_2.has-hover: {
                                            background: #334155;
                                            border-color: #38bdf8;
                                        }
                                    ]

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../../assets/ui/reset.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: #38bdf8;
                                            }
                                        }
                                        Text { text: "Valores por defecto"; font-size: 12px; font-weight: 600; color: #f1f5f9; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    width: 190px;
                                    height: 32px;
                                    background: #0284c7;
                                    border-radius: 6px;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.import_video_to_vault_clicked();
                                        }
                                    }
                                    Text {
                                        text: "+ 📁 Importar Video...";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #F5F5F5;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Lista de Videos en el Baúl con ScrollView
                        Rectangle {
                            height: 230px;
                            background: #090e1a;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #334155;
                            clip: true;

                            if root.vault_videos.length == 0: Text {
                                text: "El baúl está vacío. Haz clic en 'Importar Video' para añadir videos MP4.";
                                font-size: 12px;
                                color: #64748b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            if root.vault_videos.length > 0: ScrollView {
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 6px;
                                    alignment: start;
                                    for item in root.vault_videos: Rectangle {
                                        background: #1e293b;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.assigning_video_path == item.path ? #0284c7 : #334155;

                                        VerticalLayout {
                                            padding: 6px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 8px;
                                                alignment: space-between;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;
                                                    horizontal-stretch: 1;

                                                    Text {
                                                        text: "🎬 " + item.name;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: #f1f5f9;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: "(" + item.size_str + ")";
                                                        font-size: 10px;
                                                        color: #64748b;
                                                        vertical-alignment: center;
                                                    }
                                                    if item.is_preloaded: Rectangle {
                                                        height: 18px;
                                                        background: #0284c722;
                                                        border-radius: 4px;
                                                        border-width: 1px;
                                                        border-color: #0284c766;
                                                        HorizontalLayout {
                                                            padding-left: 6px;
                                                            padding-right: 6px;
                                                            Text {
                                                                text: "Precargado";
                                                                font-size: 9px;
                                                                font-weight: 700;
                                                                color: #38bdf8;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: end;

                                                    // Botón "Asignar"
                                                    Rectangle {
                                                        width: 92px;
                                                        height: 26px;
                                                        background: root.assigning_video_path == item.path ? #0284c7 : #0f172a;
                                                        border-radius: 5px;
                                                        border-width: 1px;
                                                        border-color: root.assigning_video_path == item.path ? #38bdf8 : #0284c7;

                                                        touch_assign := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if root.assigning_video_path == item.path {
                                                                    root.assigning_video_path = "";
                                                                } else {
                                                                    root.assigning_video_path = item.path;
                                                                }
                                                            }
                                                        }

                                                        HorizontalLayout {
                                                            alignment: center;
                                                            spacing: 5px;
                                                            padding-left: 6px;
                                                            padding-right: 6px;

                                                            Text {
                                                                text: "📌";
                                                                font-size: 11px;
                                                                vertical-alignment: center;
                                                            }
                                                            Text {
                                                                text: "Asignar";
                                                                font-size: 11px;
                                                                font-weight: 700;
                                                                color: #F5F5F5;
                                                                vertical-alignment: center;
                                                            }
                                                            Text {
                                                                text: root.assigning_video_path == item.path ? "▲" : "▼";
                                                                font-size: 10px;
                                                                font-weight: 800;
                                                                color: #38bdf8;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    // Botón Eliminar (SOLO para videos que NO son del sistema / precargados)
                                                    if !item.is_preloaded: Rectangle {
                                                        width: 28px;
                                                        height: 26px;
                                                        background: touch_del.has-hover ? #ef444466 : #ef444433;
                                                        border-radius: 5px;

                                                        touch_del := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.delete_vault_video_clicked(item.filename);
                                                            }
                                                        }
                                                        Text {
                                                            text: "🗑️";
                                                            font-size: 11px;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            // Menú desplegable de slots: Landing, Slot 1, Slot 2, Slot 3
                                            if root.assigning_video_path == item.path: Rectangle {
                                                background: #0f172a;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: #0284c788;

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    padding-top: 6px;
                                                    padding-bottom: 6px;
                                                    spacing: 8px;
                                                    alignment: end;

                                                    Text {
                                                        text: "Asignar a:";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: #94a3b8;
                                                        vertical-alignment: center;
                                                    }

                                                    // Landing Video
                                                    Rectangle {
                                                        width: 66px;
                                                        height: 24px;
                                                        background: touch_landing.has-hover ? #0284c7 : #1e293b;
                                                        border-radius: 4px;
                                                        border-width: 1px;
                                                        border-color: #0284c7;
                                                        touch_landing := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.cfg_central_video = item.path;
                                                                root.assigning_video_path = "";
                                                            }
                                                        }
                                                        Text { text: "Landing"; font-size: 10px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                                    }

                                                    // Slot 1
                                                    Rectangle {
                                                        width: 58px;
                                                        height: 24px;
                                                        background: touch_s1.has-hover ? #0284c7 : #1e293b;
                                                        border-radius: 4px;
                                                        border-width: 1px;
                                                        border-color: #0284c7;
                                                        touch_s1 := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.cfg_inactivity_video_1 = item.path;
                                                                root.assigning_video_path = "";
                                                            }
                                                        }
                                                        Text { text: "Slot 1"; font-size: 10px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                                    }

                                                    // Slot 2
                                                    Rectangle {
                                                        width: 58px;
                                                        height: 24px;
                                                        background: touch_s2.has-hover ? #0284c7 : #1e293b;
                                                        border-radius: 4px;
                                                        border-width: 1px;
                                                        border-color: #0284c7;
                                                        touch_s2 := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.cfg_inactivity_video_2 = item.path;
                                                                root.assigning_video_path = "";
                                                            }
                                                        }
                                                        Text { text: "Slot 2"; font-size: 10px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                                    }

                                                    // Slot 3
                                                    Rectangle {
                                                        width: 58px;
                                                        height: 24px;
                                                        background: touch_s3.has-hover ? #0284c7 : #1e293b;
                                                        border-radius: 4px;
                                                        border-width: 1px;
                                                        border-color: #0284c7;
                                                        touch_s3 := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.cfg_inactivity_video_3 = item.path;
                                                                root.assigning_video_path = "";
                                                            }
                                                        }
                                                        Text { text: "Slot 3"; font-size: 10px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 3: INTERFAZ Y COLORES
                    if root.admin_tab_index == 3: ScrollView {
                        content-height: 590px;

                        VerticalLayout {
                            alignment: start;
                            spacing: 14px;
                            padding-top: 4px;
                            padding-bottom: 12px;
                            padding-right: 10px;

                            // Section 0: Selector de Modo Claro / Oscuro
                            VerticalLayout {
                                alignment: start;
                                spacing: 6px;
                                Text {
                                    text: "Modo de Interfaz:";
                                    font-size: 13px;
                                    font-weight: 800;
                                    color: #38bdf8;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    height: 40px;

                                    // Botón Modo Claro
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: !root.is_dark_mode ? #0284c7 : #1e293b;
                                        border-radius: 8px;
                                        border-width: 1.5px;
                                        border-color: !root.is_dark_mode ? #38bdf8 : #334155;

                                        touch_light := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.is_dark_mode = false;
                                                if root.cfg_accent == "#a855f7" || root.cfg_accent == "#9333ea" || root.cfg_accent == "#7c3aed" || root.cfg_accent == "#6366f1" {
                                                    // Púrpura -> Lavanda Dream
                                                    root.cfg_bg_base = "#ede9fe";
                                                    root.cfg_card_bg = "#F5F5F5";
                                                    root.cfg_card_border = "#c4b5fd";
                                                    root.cfg_text_primary = "#2e1065";
                                                    root.cfg_text_secondary = "#5b21b6";
                                                    root.cfg_accent = "#7c3aed";
                                                    root.cfg_btn_bg = "#7c3aed";
                                                    root.cfg_btn_text = "#F5F5F5";
                                                    root.update_bg_base_color("#ede9fe");
                                                } else if root.cfg_accent == "#ef4444" || root.cfg_accent == "#dc2626" || root.cfg_accent == "#e11d48" || root.cfg_accent == "#f43f5e" || root.cfg_accent == "#ec4899" {
                                                    // Rojo -> Carmesí Claro
                                                    root.cfg_bg_base = "#ffe4e6";
                                                    root.cfg_card_bg = "#F5F5F5";
                                                    root.cfg_card_border = "#fecdd3";
                                                    root.cfg_text_primary = "#4c0519";
                                                    root.cfg_text_secondary = "#e11d48";
                                                    root.cfg_accent = "#e11d48";
                                                    root.cfg_btn_bg = "#e11d48";
                                                    root.cfg_btn_text = "#F5F5F5";
                                                    root.update_bg_base_color("#ffe4e6");
                                                } else if root.cfg_accent == "#f97316" || root.cfg_accent == "#ea580c" {
                                                    // Naranja -> Sunset Cálido
                                                    root.cfg_bg_base = "#fed7aa";
                                                    root.cfg_card_bg = "#F5F5F5";
                                                    root.cfg_card_border = "#fdba74";
                                                    root.cfg_text_primary = "#431407";
                                                    root.cfg_text_secondary = "#7c2d12";
                                                    root.cfg_accent = "#ea580c";
                                                    root.cfg_btn_bg = "#ea580c";
                                                    root.cfg_btn_text = "#F5F5F5";
                                                    root.update_bg_base_color("#fed7aa");
                                                } else if root.cfg_accent == "#10b981" || root.cfg_accent == "#059669" {
                                                    // Verde -> Menta Suave
                                                    root.cfg_bg_base = "#bbf0d4";
                                                    root.cfg_card_bg = "#F5F5F5";
                                                    root.cfg_card_border = "#86efac";
                                                    root.cfg_text_primary = "#064e3b";
                                                    root.cfg_text_secondary = "#047857";
                                                    root.cfg_accent = "#059669";
                                                    root.cfg_btn_bg = "#059669";
                                                    root.cfg_btn_text = "#F5F5F5";
                                                    root.update_bg_base_color("#bbf0d4");
                                                } else {
                                                    // Celeste -> Pastel Zenit
                                                    root.cfg_bg_base = "#cce5f8";
                                                    root.cfg_card_bg = "#F5F5F5";
                                                    root.cfg_card_border = "#bae6fd";
                                                    root.cfg_text_primary = "#0f172a";
                                                    root.cfg_text_secondary = "#475569";
                                                    root.cfg_accent = "#0284c7";
                                                    root.cfg_btn_bg = "#0284c7";
                                                    root.cfg_btn_text = "#F5F5F5";
                                                    root.update_bg_base_color("#cce5f8");
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            Text { text: "☀️"; font-size: 16px; vertical-alignment: center; }
                                            Text {
                                                text: "Modo Claro";
                                                font-size: 13px;
                                                font-weight: 800;
                                                color: !root.is_dark_mode ? #F5F5F5 : #94a3b8;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Botón Modo Oscuro
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.is_dark_mode ? #0284c7 : #1e293b;
                                        border-radius: 8px;
                                        border-width: 1.5px;
                                        border-color: root.is_dark_mode ? #38bdf8 : #334155;

                                        touch_dark := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.is_dark_mode = true;
                                                if root.cfg_accent == "#7c3aed" || root.cfg_accent == "#a855f7" || root.cfg_accent == "#9333ea" || root.cfg_accent == "#6366f1" {
                                                    // Púrpura -> Neon Violet (+20% claro)
                                                    root.cfg_bg_base = "#1a1332";
                                                    root.cfg_card_bg = "#231a44";
                                                    root.cfg_card_border = "#39226d";
                                                    root.cfg_text_primary = "#F5F5F5";
                                                    root.cfg_text_secondary = "#a78bfa";
                                                    root.cfg_accent = "#a855f7";
                                                    root.cfg_btn_bg = "#9333ea";
                                                    root.cfg_btn_text = "#F5F5F5";
                                                    root.update_bg_base_color("#1a1332");
                                                } else if root.cfg_accent == "#e11d48" || root.cfg_accent == "#ef4444" || root.cfg_accent == "#dc2626" || root.cfg_accent == "#f43f5e" || root.cfg_accent == "#ec4899" {
                                                    // Rojo -> Carmesí Dark (+20% claro)
                                                    root.cfg_bg_base = "#221217";
                                                    root.cfg_card_bg = "#2c181f";
                                                    root.cfg_card_border = "#4d1c25";
                                                    root.cfg_text_primary = "#F5F5F5";
                                                    root.cfg_text_secondary = "#f87171";
                                                    root.cfg_accent = "#ef4444";
                                                    root.cfg_btn_bg = "#dc2626";
                                                    root.cfg_btn_text = "#F5F5F5";
                                                    root.update_bg_base_color("#221217");
                                                } else if root.cfg_accent == "#ea580c" || root.cfg_accent == "#f97316" {
                                                    // Naranja -> Sunset Dark (+20% claro)
                                                    root.cfg_bg_base = "#26150a";
                                                    root.cfg_card_bg = "#331c0e";
                                                    root.cfg_card_border = "#522610";
                                                    root.cfg_text_primary = "#F5F5F5";
                                                    root.cfg_text_secondary = "#fb923c";
                                                    root.cfg_accent = "#f97316";
                                                    root.cfg_btn_bg = "#ea580c";
                                                    root.cfg_btn_text = "#F5F5F5";
                                                    root.update_bg_base_color("#26150a");
                                                } else if root.cfg_accent == "#059669" || root.cfg_accent == "#10b981" {
                                                    // Verde -> Matrix Dark (+20% claro)
                                                    root.cfg_bg_base = "#102118";
                                                    root.cfg_card_bg = "#162e21";
                                                    root.cfg_card_border = "#1d4632";
                                                    root.cfg_text_primary = "#F5F5F5";
                                                    root.cfg_text_secondary = "#34d399";
                                                    root.cfg_accent = "#10b981";
                                                    root.cfg_btn_bg = "#059669";
                                                    root.cfg_btn_text = "#F5F5F5";
                                                    root.update_bg_base_color("#102118");
                                                } else {
                                                    // Celeste -> Cyber Deep (+20% claro)
                                                    root.cfg_bg_base = "#131b2e";
                                                    root.cfg_card_bg = "#1b263b";
                                                    root.cfg_card_border = "#293952";
                                                    root.cfg_text_primary = "#F5F5F5";
                                                    root.cfg_text_secondary = "#94a3b8";
                                                    root.cfg_accent = "#38bdf8";
                                                    root.cfg_btn_bg = "#0284c7";
                                                    root.cfg_btn_text = "#F5F5F5";
                                                    root.update_bg_base_color("#131b2e");
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            Text { text: "🌙"; font-size: 16px; vertical-alignment: center; }
                                            Text {
                                                text: "Modo Oscuro";
                                                font-size: 13px;
                                                font-weight: 800;
                                                color: root.is_dark_mode ? #F5F5F5 : #94a3b8;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // Section 1: Presets de Temas
                            VerticalLayout {
                                alignment: start;
                                spacing: 6px;
                                Text {
                                    text: root.is_dark_mode ? "Presets de Temas Oscuros (Selecciona un estilo):" : "Presets de Temas Claros (Selecciona un estilo):";
                                    font-size: 13px;
                                    font-weight: 800;
                                    color: #38bdf8;
                                }

                                if !root.is_dark_mode: HorizontalLayout {
                                    spacing: 8px;
                                    height: 38px;

                                    // Preset Claro 1: Celeste (Pastel Zenit)
                                    Rectangle {
                                        background: #1e293b;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #0284c7;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.cfg_bg_base = "#cce5f8";
                                                root.cfg_card_bg = "#F5F5F5";
                                                root.cfg_card_border = "#bae6fd";
                                                root.cfg_text_primary = "#0f172a";
                                                root.cfg_text_secondary = "#475569";
                                                root.cfg_accent = "#0284c7";
                                                root.cfg_btn_bg = "#0284c7";
                                                root.cfg_btn_text = "#F5F5F5";
                                                root.update_bg_base_color("#cce5f8");
                                            }
                                        }
                                        Text { text: "🔵 Pastel Zenit"; font-size: 11px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    // Preset Claro 2: Púrpura (Lavanda Dream)
                                    Rectangle {
                                        background: #1e293b;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #7c3aed;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.cfg_bg_base = "#ede9fe";
                                                root.cfg_card_bg = "#F5F5F5";
                                                root.cfg_card_border = "#c4b5fd";
                                                root.cfg_text_primary = "#2e1065";
                                                root.cfg_text_secondary = "#5b21b6";
                                                root.cfg_accent = "#7c3aed";
                                                root.cfg_btn_bg = "#7c3aed";
                                                root.cfg_btn_text = "#F5F5F5";
                                                root.update_bg_base_color("#ede9fe");
                                            }
                                        }
                                        Text { text: "🟣 Lavanda Dream"; font-size: 11px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    // Preset Claro 3: Rojo (Carmesí Claro)
                                    Rectangle {
                                        background: #1e293b;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #e11d48;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.cfg_bg_base = "#ffe4e6";
                                                root.cfg_card_bg = "#F5F5F5";
                                                root.cfg_card_border = "#fecdd3";
                                                root.cfg_text_primary = "#4c0519";
                                                root.cfg_text_secondary = "#e11d48";
                                                root.cfg_accent = "#e11d48";
                                                root.cfg_btn_bg = "#e11d48";
                                                root.cfg_btn_text = "#F5F5F5";
                                                root.update_bg_base_color("#ffe4e6");
                                            }
                                        }
                                        Text { text: "🔴 Carmesí Claro"; font-size: 11px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    // Preset Claro 4: Naranja (Sunset Cálido)
                                    Rectangle {
                                        background: #1e293b;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #ea580c;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.cfg_bg_base = "#fed7aa";
                                                root.cfg_card_bg = "#F5F5F5";
                                                root.cfg_card_border = "#fdba74";
                                                root.cfg_text_primary = "#431407";
                                                root.cfg_text_secondary = "#7c2d12";
                                                root.cfg_accent = "#ea580c";
                                                root.cfg_btn_bg = "#ea580c";
                                                root.cfg_btn_text = "#F5F5F5";
                                                root.update_bg_base_color("#fed7aa");
                                            }
                                        }
                                        Text { text: "🟠 Sunset Cálido"; font-size: 11px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    // Preset Claro 5: Verde (Menta Suave)
                                    Rectangle {
                                        background: #1e293b;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #059669;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.cfg_bg_base = "#bbf0d4";
                                                root.cfg_card_bg = "#F5F5F5";
                                                root.cfg_card_border = "#86efac";
                                                root.cfg_text_primary = "#064e3b";
                                                root.cfg_text_secondary = "#047857";
                                                root.cfg_accent = "#059669";
                                                root.cfg_btn_bg = "#059669";
                                                root.cfg_btn_text = "#F5F5F5";
                                                root.update_bg_base_color("#bbf0d4");
                                            }
                                        }
                                        Text { text: "🟢 Menta Suave"; font-size: 11px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }

                                if root.is_dark_mode: HorizontalLayout {
                                    spacing: 8px;
                                    height: 38px;

                                    // Preset Oscuro 1: Celeste (Cyber Deep)
                                    Rectangle {
                                        background: #1e293b;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #38bdf8;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.cfg_bg_base = "#131b2e";
                                                root.cfg_card_bg = "#1b263b";
                                                root.cfg_card_border = "#293952";
                                                root.cfg_text_primary = "#F5F5F5";
                                                root.cfg_text_secondary = "#94a3b8";
                                                root.cfg_accent = "#38bdf8";
                                                root.cfg_btn_bg = "#0284c7";
                                                root.cfg_btn_text = "#F5F5F5";
                                                root.update_bg_base_color("#131b2e");
                                            }
                                        }
                                        Text { text: "🌌 Cyber Deep"; font-size: 11px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    // Preset Oscuro 2: Púrpura (Neon Violet)
                                    Rectangle {
                                        background: #1e293b;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #a855f7;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.cfg_bg_base = "#1a1332";
                                                root.cfg_card_bg = "#231a44";
                                                root.cfg_card_border = "#39226d";
                                                root.cfg_text_primary = "#F5F5F5";
                                                root.cfg_text_secondary = "#a78bfa";
                                                root.cfg_accent = "#a855f7";
                                                root.cfg_btn_bg = "#9333ea";
                                                root.cfg_btn_text = "#F5F5F5";
                                                root.update_bg_base_color("#1a1332");
                                            }
                                        }
                                        Text { text: "🟣 Neon Violet"; font-size: 11px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    // Preset Oscuro 3: Rojo (Carmesí Dark)
                                    Rectangle {
                                        background: #1e293b;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #e11d48;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.cfg_bg_base = "#221217";
                                                root.cfg_card_bg = "#2c181f";
                                                root.cfg_card_border = "#4d1c25";
                                                root.cfg_text_primary = "#F5F5F5";
                                                root.cfg_text_secondary = "#f87171";
                                                root.cfg_accent = "#ef4444";
                                                root.cfg_btn_bg = "#dc2626";
                                                root.cfg_btn_text = "#F5F5F5";
                                                root.update_bg_base_color("#221217");
                                            }
                                        }
                                        Text { text: "🔴 Carmesí Dark"; font-size: 11px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    // Preset Oscuro 4: Naranja (Sunset Dark)
                                    Rectangle {
                                        background: #1e293b;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #f97316;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.cfg_bg_base = "#26150a";
                                                root.cfg_card_bg = "#331c0e";
                                                root.cfg_card_border = "#522610";
                                                root.cfg_text_primary = "#F5F5F5";
                                                root.cfg_text_secondary = "#fb923c";
                                                root.cfg_accent = "#f97316";
                                                root.cfg_btn_bg = "#ea580c";
                                                root.cfg_btn_text = "#F5F5F5";
                                                root.update_bg_base_color("#26150a");
                                            }
                                        }
                                        Text { text: "🟠 Sunset Dark"; font-size: 11px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    // Preset Oscuro 5: Verde (Matrix Dark)
                                    Rectangle {
                                        background: #1e293b;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #10b981;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.cfg_bg_base = "#102118";
                                                root.cfg_card_bg = "#162e21";
                                                root.cfg_card_border = "#1d4632";
                                                root.cfg_text_primary = "#F5F5F5";
                                                root.cfg_text_secondary = "#34d399";
                                                root.cfg_accent = "#10b981";
                                                root.cfg_btn_bg = "#059669";
                                                root.cfg_btn_text = "#F5F5F5";
                                                root.update_bg_base_color("#102118");
                                            }
                                        }
                                        Text { text: "🟢 Matrix Dark"; font-size: 11px; font-weight: 700; color: #F5F5F5; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }

                            // Section 2: Paleta Rápida de Colores Primarios
                            VerticalLayout {
                                alignment: start;
                                spacing: 4px;
                                Text {
                                    text: "Paleta Rápida de Color Highlight / Acento y Botón:";
                                    font-size: 13px;
                                    font-weight: 800;
                                    color: #38bdf8;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    height: 32px;

                                    Rectangle { width: 32px; height: 32px; border-radius: 16px; background: #0284c7; border-width: 2px; border-color: root.cfg_accent == "#0284c7" ? #F5F5F5 : #334155; TouchArea { mouse-cursor: pointer; clicked => { root.cfg_accent = "#0284c7"; root.cfg_btn_bg = "#0284c7"; } } }
                                    Rectangle { width: 32px; height: 32px; border-radius: 16px; background: #06b6d4; border-width: 2px; border-color: root.cfg_accent == "#06b6d4" ? #F5F5F5 : #334155; TouchArea { mouse-cursor: pointer; clicked => { root.cfg_accent = "#06b6d4"; root.cfg_btn_bg = "#06b6d4"; } } }
                                    Rectangle { width: 32px; height: 32px; border-radius: 16px; background: #6366f1; border-width: 2px; border-color: root.cfg_accent == "#6366f1" ? #F5F5F5 : #334155; TouchArea { mouse-cursor: pointer; clicked => { root.cfg_accent = "#6366f1"; root.cfg_btn_bg = "#6366f1"; } } }
                                    Rectangle { width: 32px; height: 32px; border-radius: 16px; background: #a855f7; border-width: 2px; border-color: root.cfg_accent == "#a855f7" ? #F5F5F5 : #334155; TouchArea { mouse-cursor: pointer; clicked => { root.cfg_accent = "#a855f7"; root.cfg_btn_bg = "#a855f7"; } } }
                                    Rectangle { width: 32px; height: 32px; border-radius: 16px; background: #ec4899; border-width: 2px; border-color: root.cfg_accent == "#ec4899" ? #F5F5F5 : #334155; TouchArea { mouse-cursor: pointer; clicked => { root.cfg_accent = "#ec4899"; root.cfg_btn_bg = "#ec4899"; } } }
                                    Rectangle { width: 32px; height: 32px; border-radius: 16px; background: #e11d48; border-width: 2px; border-color: root.cfg_accent == "#e11d48" ? #F5F5F5 : #334155; TouchArea { mouse-cursor: pointer; clicked => { root.cfg_accent = "#e11d48"; root.cfg_btn_bg = "#e11d48"; } } }
                                    Rectangle { width: 32px; height: 32px; border-radius: 16px; background: #f97316; border-width: 2px; border-color: root.cfg_accent == "#f97316" ? #F5F5F5 : #334155; TouchArea { mouse-cursor: pointer; clicked => { root.cfg_accent = "#f97316"; root.cfg_btn_bg = "#f97316"; } } }
                                    Rectangle { width: 32px; height: 32px; border-radius: 16px; background: #10b981; border-width: 2px; border-color: root.cfg_accent == "#10b981" ? #F5F5F5 : #334155; TouchArea { mouse-cursor: pointer; clicked => { root.cfg_accent = "#10b981"; root.cfg_btn_bg = "#10b981"; } } }
                                }
                            }

                            // Section 3: Manual Hex Inputs (Colapsable / Acordeón)
                            Rectangle {
                                height: 36px;
                                background: #1e293b;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: root.show_advanced_colors ? #38bdf8 : #475569;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show_advanced_colors = !root.show_advanced_colors;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: root.show_advanced_colors ? "▲ Ocultar personalización manual de colores" : "▶ Personalización manual avanzada de colores (Códigos HEX)";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: root.show_advanced_colors ? #38bdf8 : #94a3b8;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if root.show_advanced_colors: VerticalLayout {
                                alignment: start;
                                spacing: 8px;

                                // Fila 1: Degradado Fondo Análogo (Único Color Base)
                                HorizontalLayout {
                                    spacing: 14px;
                                    ColorPickerInput {
                                        horizontal-stretch: 1;
                                        label: "Color Base de Fondo (Degradado Análogo de 3 Colores):";
                                        text <=> root.cfg_bg_base;
                                        preview_color: root.hex_to_color(root.cfg_bg_base);
                                        field_name: "bg_base";
                                        pick_clicked(f) => { root.pick_color_clicked(f); }
                                        edited(val) => { root.update_bg_base_color(val); }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: "Degradado Generado (3 Colores):";
                                            font-size: 11px;
                                            color: #cbd5e1;
                                            font-weight: 500;
                                        }
                                        Rectangle {
                                            height: 34px;
                                            border-radius: 6px;
                                            border-width: 1.5px;
                                            border-color: #475569;
                                            clip: true;
                                            background: @linear-gradient(90deg, root.hex_to_color(root.cfg_bg_start) 0%, root.hex_to_color(root.cfg_bg_mid) 50%, root.hex_to_color(root.cfg_bg_end) 100%);
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                alignment: space-between;
                                                Text {
                                                    text: root.cfg_bg_start;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: #0f172a;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: root.cfg_bg_mid;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: #0f172a;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: root.cfg_bg_end;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: #0f172a;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Fila 2: Recuadros Specs
                                HorizontalLayout {
                                    spacing: 14px;
                                    ColorPickerInput {
                                        horizontal-stretch: 1;
                                        label: "Fondo de Recuadros (Specs):";
                                        text <=> root.cfg_card_bg;
                                        preview_color: root.hex_to_color(root.cfg_card_bg);
                                        field_name: "card_bg";
                                        pick_clicked(f) => { root.pick_color_clicked(f); }
                                    }
                                    ColorPickerInput {
                                        horizontal-stretch: 1;
                                        label: "Borde de Recuadros (Specs):";
                                        text <=> root.cfg_card_border;
                                        preview_color: root.hex_to_color(root.cfg_card_border);
                                        field_name: "card_border";
                                        pick_clicked(f) => { root.pick_color_clicked(f); }
                                    }
                                }

                                // Fila 3: Textos
                                HorizontalLayout {
                                    spacing: 14px;
                                    ColorPickerInput {
                                        horizontal-stretch: 1;
                                        label: "Texto Principal (Valores/Modelo):";
                                        text <=> root.cfg_text_primary;
                                        preview_color: root.hex_to_color(root.cfg_text_primary);
                                        field_name: "text_primary";
                                        pick_clicked(f) => { root.pick_color_clicked(f); }
                                    }
                                    ColorPickerInput {
                                        horizontal-stretch: 1;
                                        label: "Texto Secundario (Títulos de specs):";
                                        text <=> root.cfg_text_secondary;
                                        preview_color: root.hex_to_color(root.cfg_text_secondary);
                                        field_name: "text_secondary";
                                        pick_clicked(f) => { root.pick_color_clicked(f); }
                                    }
                                }

                                // Fila 4: Highlight y Botón
                                HorizontalLayout {
                                    spacing: 14px;
                                    ColorPickerInput {
                                        horizontal-stretch: 1;
                                        label: "Color Highlight / Acento:";
                                        text <=> root.cfg_accent;
                                        preview_color: root.hex_to_color(root.cfg_accent);
                                        field_name: "accent";
                                        pick_clicked(f) => { root.pick_color_clicked(f); }
                                    }
                                    ColorPickerInput {
                                        horizontal-stretch: 1;
                                        label: "Fondo Botón Acción:";
                                        text <=> root.cfg_btn_bg;
                                        preview_color: root.hex_to_color(root.cfg_btn_bg);
                                        field_name: "btn_bg";
                                        pick_clicked(f) => { root.pick_color_clicked(f); }
                                    }
                                    ColorPickerInput {
                                        horizontal-stretch: 1;
                                        label: "Texto Botón Acción:";
                                        text <=> root.cfg_btn_text;
                                        preview_color: root.hex_to_color(root.cfg_btn_text);
                                        field_name: "btn_text";
                                        pick_clicked(f) => { root.pick_color_clicked(f); }
                                    }
                                }
                            }

                            // Botón Restablecer Colores a Fábrica
                            Rectangle {
                                height: 38px;
                                background: #1e293b;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #475569;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.is_dark_mode = false;
                                        root.cfg_bg_base = "#cce5f8";
                                        root.cfg_card_bg = "#F5F5F5";
                                        root.cfg_card_border = "#bae6fd";
                                        root.cfg_text_primary = "#0f172a";
                                        root.cfg_text_secondary = "#475569";
                                        root.cfg_accent = "#0284c7";
                                        root.cfg_btn_bg = "#0284c7";
                                        root.cfg_btn_text = "#F5F5F5";
                                        root.update_bg_base_color("#cce5f8");
                                        root.reset_ui_defaults();
                                    }
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: "🔄 Restablecer Colores de Interfaz a Valores de Fábrica";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #38bdf8;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // TAB 4: SISTEMA
                    if root.admin_tab_index == 4: VerticalLayout {
                        spacing: 16px;
                        alignment: center;

                        // Reset All Defaults Button
                        Rectangle {
                            height: 46px;
                            background: #1e293b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #475569;

                            touch_reset_3 := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.reset_system_defaults();
                                }
                            }

                            states [
                                hover when touch_reset_3.has-hover: {
                                    background: #334155;
                                    border-color: #38bdf8;
                                }
                            ]

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/ui/reset.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: #38bdf8;
                                    }
                                }
                                Text { text: "Valores por defecto (Restablecer Todo a Fábrica)"; font-size: 14px; font-weight: 700; color: #f1f5f9; vertical-alignment: center; }
                            }
                        }

                        // Restart App
                        Rectangle {
                            height: 42px;
                            background: #d97706;
                            border-radius: 8px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.emergency_restart_clicked(); }
                            }
                            Text {
                                text: "🔄 Reiniciar Aplicación";
                                font-size: 14px;
                                font-weight: 700;
                                color: #F5F5F5;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Exit to Windows
                        Rectangle {
                            height: 42px;
                            background: #dc2626;
                            border-radius: 8px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.emergency_exit_clicked(); }
                            }
                            Text {
                                text: "🚪 Salir a Windows (Cerrar Aplicación)";
                                font-size: 14px;
                                font-weight: 700;
                                color: #F5F5F5;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Modal Footer
                HorizontalLayout {
                    spacing: 12px;
                    height: 44px;

                    Rectangle {
                        background: #0284c7;
                        border-radius: 8px;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.is_dirty = false;
                                root.save_admin_config(
                                    root.cfg_brand, root.cfg_model, root.cfg_retail, root.cfg_card_price, root.cfg_normal_price, root.cfg_sku,
                                    root.cfg_cpu, root.cfg_ram, root.cfg_storage, root.cfg_gpu, root.cfg_display, root.cfg_os, root.cfg_battery, root.cfg_others,
                                    root.cfg_central_video, root.cfg_bg_video, root.cfg_inactivity_video_1, root.cfg_inactivity_video_2, root.cfg_inactivity_video_3, root.cfg_inactivity_timeout
                                );
                            }
                        }

                        Text {
                            text: "💾 Guardar Cambios";
                            font-size: 14px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 120px;
                        background: #1e293b;
                        border-radius: 8px;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if root.is_dirty {
                                    root.show_discard_confirm = true;
                                } else {
                                    root.close_admin_clicked();
                                }
                            }
                        }

                        Text {
                            text: "Cerrar";
                            font-size: 14px;
                            font-weight: 600;
                            color: #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // POPUP: Vault Video Selector Modal Overlay
            if root.active_video_picker > 0: Rectangle {
                width: 100%;
                height: 100%;
                background: #000000d9;
                border-radius: 20px;

                TouchArea {
                    clicked => {
                        root.active_video_picker = 0;
                    }
                }

                Rectangle {
                    width: 580px;
                    height: 440px;
                    background: #0f172a;
                    border-radius: 16px;
                    border-width: 1.5px;
                    border-color: #38bdf8;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    TouchArea {}

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        // Header
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: root.active_video_picker == 1 ? "🎬 Seleccionar Video para Inactividad #1" :
                                          root.active_video_picker == 2 ? "🎬 Seleccionar Video para Inactividad #2" :
                                          root.active_video_picker == 3 ? "🎬 Seleccionar Video para Inactividad #3" :
                                          "🎬 Seleccionar Video Central Landing";
                                    font-size: 15px;
                                    font-weight: 800;
                                    color: #F5F5F5;
                                }
                                Text {
                                    text: "Selecciona un video precargado del Baúl o importa uno nuevo:";
                                    font-size: 11px;
                                    color: #94a3b8;
                                }
                            }

                            // Close X
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: touch_close_picker.has-hover ? #ef4444 : #1e293b;
                                touch_close_picker := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.active_video_picker = 0;
                                    }
                                }
                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 12px;
                                    height: 12px;
                                    source: @image-url("../../assets/ui/close.svg");
                                    colorize: #F5F5F5;
                                }
                            }
                        }

                        // Video List Container
                        Rectangle {
                            vertical-stretch: 1;
                            background: #090e1a;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #334155;
                            clip: true;

                            if root.vault_videos.length == 0: VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: "El baúl no tiene videos guardados aún.";
                                    font-size: 13px;
                                    color: #64748b;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Haz clic abajo en 'Añadir nuevo video desde tu PC' para importar videos MP4.";
                                    font-size: 11px;
                                    color: #475569;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.vault_videos.length > 0: ScrollView {
                                content-width: self.width;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 6px;
                                    for video in root.vault_videos: Rectangle {
                                        height: 48px;
                                        background: touch_item.has-hover ? #1e293b : #0d1526;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: touch_item.has-hover ? #38bdf8 : #1e293b;

                                        touch_item := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if root.active_video_picker == 1 {
                                                    root.cfg_inactivity_video_1 = video.path;
                                                }
                                                if root.active_video_picker == 2 {
                                                    root.cfg_inactivity_video_2 = video.path;
                                                }
                                                if root.active_video_picker == 3 {
                                                    root.cfg_inactivity_video_3 = video.path;
                                                }
                                                if root.active_video_picker == 4 {
                                                    root.cfg_central_video = video.path;
                                                }
                                                root.active_video_picker = 0;
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 10px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 10px;
                                                horizontal-stretch: 1;

                                                Text {
                                                    text: "🎬";
                                                    font-size: 16px;
                                                    vertical-alignment: center;
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text {
                                                        text: video.filename;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        color: #F5F5F5;
                                                    }
                                                    Text {
                                                        text: video.size_str;
                                                        font-size: 10px;
                                                        color: #38bdf8;
                                                    }
                                                }
                                            }

                                            // Select button
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 80px;
                                                    height: 28px;
                                                    background: touch_item.has-hover ? #0284c7 : #1e293b;
                                                    border-radius: 6px;
                                                    border-width: 1px;
                                                    border-color: touch_item.has-hover ? #38bdf8 : #475569;
                                                    Text {
                                                        text: "Elegir";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: #F5F5F5;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Footer Actions
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: space-between;

                            // Add new video button
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 36px;
                                background: #0284c7;
                                border-radius: 6px;
                                touch_pick_new := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if root.active_video_picker == 1 {
                                             root.pick_inactivity_1_clicked();
                                        }
                                        if root.active_video_picker == 2 {
                                             root.pick_inactivity_2_clicked();
                                        }
                                        if root.active_video_picker == 3 {
                                             root.pick_inactivity_3_clicked();
                                        }
                                        if root.active_video_picker == 4 {
                                             root.pick_central_video_clicked();
                                        }
                                        root.active_video_picker = 0;
                                    }
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text { text: "+ 📁"; font-size: 14px; vertical-alignment: center; }
                                    Text { text: "Añadir nuevo video desde tu PC..."; font-size: 12px; font-weight: 700; color: #F5F5F5; vertical-alignment: center; }
                                }
                            }

                            // Clear slot button
                            Rectangle {
                                width: 140px;
                                height: 36px;
                                background: #1e293b;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #475569;
                                touch_clear_slot := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if root.active_video_picker == 1 {
                                            root.try_clear_video(1);
                                        }
                                        if root.active_video_picker == 2 {
                                            root.try_clear_video(2);
                                        }
                                        if root.active_video_picker == 3 {
                                            root.try_clear_video(3);
                                        }
                                        if root.active_video_picker == 4 {
                                            root.try_clear_video(4);
                                        }
                                        root.active_video_picker = 0;
                                    }
                                }
                                states [
                                    hover when touch_clear_slot.has-hover: {
                                        background: #ef444433;
                                        border-color: #ef4444;
                                    }
                                ]
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            width: 12px;
                                            height: 12px;
                                            source: @image-url("../../assets/ui/close.svg");
                                            colorize: touch_clear_slot.has-hover ? #ef4444 : #94a3b8;
                                        }
                                    }
                                    Text {
                                        text: "Quitar Video";
                                        font-size: 12px;
                                        color: touch_clear_slot.has-hover ? #ef4444 : #94a3b8;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // POPUP: Confirmación de Descarte de Cambios
            if root.show_discard_confirm: Rectangle {
                width: 100%;
                height: 100%;
                background: #000000d9;
                border-radius: 20px;

                TouchArea {} // Absorber clics de fondo

                Rectangle {
                    width: 440px;
                    height: 200px;
                    background: #0f172a;
                    border-radius: 16px;
                    border-width: 1.5px;
                    border-color: #f59e0b;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    VerticalLayout {
                        padding: 22px;
                        spacing: 14px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text { text: "⚠️"; font-size: 20px; vertical-alignment: center; }
                            Text {
                                text: "Cambios sin guardar";
                                font-size: 16px;
                                font-weight: 800;
                                color: #f59e0b;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Tienes modificaciones sin guardar en la configuración. ¿Deseas salir y descartar los cambios?";
                            font-size: 12px;
                            color: #cbd5e1;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;

                            // Botón Cancelar
                            Rectangle {
                                width: 85px;
                                height: 36px;
                                background: #1e293b;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #475569;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show_discard_confirm = false;
                                    }
                                }
                                Text {
                                    text: "Cancelar";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #94a3b8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Botón Descartar
                            Rectangle {
                                width: 135px;
                                height: 36px;
                                background: #334155;
                                border-radius: 6px;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.is_dirty = false;
                                        root.show_discard_confirm = false;
                                        root.close_admin_clicked();
                                    }
                                }
                                Text {
                                    text: "Descartar y Salir";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #f87171;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Botón Guardar
                            Rectangle {
                                width: 140px;
                                height: 36px;
                                background: #0284c7;
                                border-radius: 6px;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.is_dirty = false;
                                        root.show_discard_confirm = false;
                                        root.save_admin_config(
                                            root.cfg_brand, root.cfg_model, root.cfg_retail, root.cfg_card_price, root.cfg_normal_price, root.cfg_sku,
                                            root.cfg_cpu, root.cfg_ram, root.cfg_storage, root.cfg_gpu, root.cfg_display, root.cfg_os, root.cfg_battery, root.cfg_others,
                                            root.cfg_central_video, root.cfg_bg_video, root.cfg_inactivity_video_1, root.cfg_inactivity_video_2, root.cfg_inactivity_video_3, root.cfg_inactivity_timeout
                                        );
                                    }
                                }
                                Text {
                                    text: "Guardar Cambios";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #F5F5F5;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
}
