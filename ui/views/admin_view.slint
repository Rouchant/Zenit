import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { VaultVideoItem } from "../theme.slint";

component ColorPickerInput inherits VerticalLayout {
    in property <string> label: "";
    in-out property <string> text <=> input.text;
    in property <color> preview_color: #F5F5F5;
    in property <string> field_name: "";
    callback pick_clicked(string);
    callback edited(string);

    spacing: 3px;
    Text { text: root.label; font-size: 11px; color: #cbd5e1; font-weight: 500; }
    HorizontalLayout {
        spacing: 6px;
        input := LineEdit {
            horizontal-stretch: 1;
            edited => { root.edited(self.text); }
        }
        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 6px;
            background: root.preview_color;
            border-width: 1.5px;
            border-color: swatch_touch.has-hover ? #38bdf8 : #475569;
            clip: true;

            swatch_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.pick_clicked(root.field_name);
                }
            }

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: #00000077;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                Text {
                    text: "🎨";
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component AdminView inherits Rectangle {
    in-out property <bool> is_admin_authenticated: false;
    in-out property <string> admin_password_input: "";
    in-out property <string> admin_error_msg: "";
    in-out property <int> admin_tab_index: 0;

    // Tab Tienda
    in-out property <string> cfg_brand: "";
    in-out property <string> cfg_brand_logo: "";
    in-out property <string> cfg_model: "";
    in-out property <string> cfg_retail: "";
    in-out property <string> cfg_card_price: "";
    in-out property <string> cfg_normal_price: "";
    in-out property <string> cfg_sku: "";

    // Tab Especificaciones
    in-out property <string> cfg_cpu: "";
    in-out property <string> cfg_ram: "";
    in-out property <string> cfg_storage: "";
    in-out property <string> cfg_gpu: "";
    in-out property <string> cfg_display: "";
    in-out property <string> cfg_os: "";
    in-out property <string> cfg_battery: "";
    in-out property <string> cfg_others: "";
    in-out property <string> cfg_badge_cpu: "";
    in-out property <string> cfg_badge_ram: "";
    in-out property <string> cfg_badge_storage: "";
    in-out property <string> cfg_badge_gpu: "";
    in-out property <string> cfg_badge_display: "";
    in-out property <string> cfg_badge_os: "";
    in-out property <string> cfg_badge_battery: "";
    in-out property <string> cfg_badge_others: "";
    in-out property <string> placeholder_badge_cpu: "GEN";
    in-out property <string> placeholder_badge_ram: "RAM";
    in-out property <string> placeholder_badge_storage: "SSD";
    in-out property <string> placeholder_badge_gpu: "GPU";
    in-out property <string> placeholder_badge_display: "165Hz";
    in-out property <string> placeholder_badge_os: "OFICIAL";
    in-out property <string> placeholder_badge_battery: "Autonomía";
    in-out property <string> placeholder_badge_others: "";

    // Tab Videos & Baúl
    in-out property <string> cfg_central_video: "";
    in-out property <string> cfg_bg_video: "";
    in-out property <string> cfg_inactivity_video_1: "";
    in-out property <string> cfg_inactivity_video_2: "";
    in-out property <string> cfg_inactivity_video_3: "";
    in-out property <string> cfg_inactivity_timeout: "120";
    in-out property <[VaultVideoItem]> vault_videos: [];

    // Tab Interfaz
    in-out property <string> cfg_bg_base: "#e3e8f5";
    in-out property <string> cfg_bg_start: "#dcedf5";
    in-out property <string> cfg_bg_mid: "#e3e8f5";
    in-out property <string> cfg_bg_end: "#eae4f5";
    in-out property <string> cfg_card_bg: "#F5F5F5";
    in-out property <string> cfg_card_border: "#e2e8f0";
    in-out property <string> cfg_text_primary: "#0f172a";
    in-out property <string> cfg_text_secondary: "#64748b";
    in-out property <string> cfg_accent: "#0284c7";
    in-out property <string> cfg_btn_bg: "#0284c7";
    in-out property <string> cfg_btn_text: "#F5F5F5";
    in-out property <bool> is_dark_mode: false;
    property <int> active_video_picker: 0;
    property <string> assigning_video_path: "";

    // Callbacks
    callback update_bg_base_color(string);
    callback close_admin_clicked();
    callback check_admin_password(string);
    callback emergency_exit_clicked();
    callback emergency_restart_clicked();
    callback auto_detect_clicked();
    callback format_currency_input(string) -> string;
    callback save_admin_config(
        string, string, string, string, string, string,
        string, string, string, string, string, string, string, string,
        string, string, string, string, string, string
    );
    callback import_video_to_vault_clicked();
    callback delete_vault_video_clicked(string);
    callback reset_store_defaults();
    callback reset_specs_defaults();
    callback reset_videos_defaults();
    callback reset_system_defaults();
    callback reset_ui_defaults();
    callback pick_central_video_clicked();
    callback pick_bg_video_clicked();
    callback pick_inactivity_1_clicked();
    callback pick_inactivity_2_clicked();
    callback pick_inactivity_3_clicked();
    callback pick_color_clicked(string);
    callback pick_brand_logo_clicked();
    pure callback hex_to_color(string) -> color;

    width: 100%;
    height: 100%;
    background: #000000e6;

        Rectangle {
            width: root.is_admin_authenticated ? 840px : 480px;
            height: root.is_admin_authenticated ? 680px : 360px;
            background: #0f172a;
            border-radius: 20px;
            border-width: 1px;
            border-color: #38bdf880;

            if !root.is_admin_authenticated: VerticalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: 16px;
                alignment: center;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Acceso de Administración";
                        font-size: 20px;
                        font-weight: 800;
                        color: #F5F5F5;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        background: touch_close_login.has-hover ? #ef4444 : #1e293b;
                        border-radius: 17px;
                        border-width: 1px;
                        border-color: touch_close_login.has-hover ? #f87171 : #475569;

                        touch_close_login := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close_admin_clicked();
                            }
                        }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/ui/close.svg");
                        }
                    }
                }

                Text {
                    text: "Ingresa la contraseña para configurar opciones avanzadas o salir.";
                    font-size: 13px;
                    color: #94a3b8;
                    horizontal-alignment: center;
                }

                pwd_ed := LineEdit {
                    placeholder-text: "Contraseña";
                    text: root.admin_password_input;
                    input-type: password;
                    accepted => {
                        root.check_admin_password(self.text);
                    }
                    edited => {
                        root.admin_password_input = self.text;
                    }
                }

                if root.admin_error_msg != "": Text {
                    text: root.admin_error_msg;
                    font-size: 12px;
                    color: #f87171;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        height: 42px;
                        background: #0284c7;
                        border-radius: 8px;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.check_admin_password(root.admin_password_input);
                            }
                        }

                        Text {
                            text: "Desbloquear";
                            font-size: 14px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 42px;
                        background: #1e293b;
                        border-radius: 8px;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close_admin_clicked();
                            }
                        }

                        Text {
                            text: "Cancelar";
                            font-size: 14px;
                            color: #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.is_admin_authenticated: VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: 16px;

                // Modal Header with highly visible close button
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Panel de Control y Configuración";
                        font-size: 20px;
                        font-weight: 800;
                        color: #F5F5F5;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        background: touch_close.has-hover ? #ef4444 : #1e293b;
                        border-radius: 17px;
                        border-width: 1px;
                        border-color: touch_close.has-hover ? #f87171 : #475569;

                        touch_close := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close_admin_clicked();
                            }
                        }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/ui/close.svg");
                        }
                    }
                }

                // Tabs Navigation Bar
                HorizontalLayout {
                    spacing: 8px;
                    height: 38px;

                    // Tab 0: Tienda
                    Rectangle {
                        background: root.admin_tab_index == 0 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 0 ? #38bdf8 : #334155;
                        TouchArea { mouse-cursor: pointer; clicked => { root.admin_tab_index = 0; } }
                        Text {
                            text: "🏪 Tienda";
                            font-size: 13px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tab 1: Especificaciones
                    Rectangle {
                        background: root.admin_tab_index == 1 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 1 ? #38bdf8 : #334155;
                        TouchArea { mouse-cursor: pointer; clicked => { root.admin_tab_index = 1; } }
                        Text {
                            text: "⚙️ Especificaciones";
                            font-size: 13px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tab 2: Videos
                    Rectangle {
                        background: root.admin_tab_index == 2 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 2 ? #38bdf8 : #334155;
                        TouchArea { mouse-cursor: pointer; clicked => { root.admin_tab_index = 2; } }
                        Text {
                            text: "🎬 Videos";
                            font-size: 13px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tab 3: Interfaz
                    Rectangle {
                        background: root.admin_tab_index == 3 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 3 ? #38bdf8 : #334155;
                        TouchArea { mouse-cursor: pointer; clicked => { root.admin_tab_index = 3; } }
                        Text {
                            text: "🎨 Interfaz";
                            font-size: 13px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tab 4: Sistema
                    Rectangle {
                        background: root.admin_tab_index == 4 ? #0284c7 : #1e293b;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.admin_tab_index == 4 ? #38bdf8 : #334155;
                        TouchArea { mouse-cursor: pointer; clicked => { root.admin_tab_index = 4; } }
                        Text {
                            text: "🛠️ Sistema";
                            font-size: 13px;
                            font-weight: 700;
                            color: #F5F5F5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Tab Content Area
                VerticalLayout {
                    vertical-stretch: 1;

                    // TAB 0: TIENDA
                    if root.admin_tab_index == 0: VerticalLayout {
                        spacing: 16px;
                        alignment: center;

                        // Logo de Marca (Aparece sobre el video central)
                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Logo de Marca (aparece arriba del video):"; font-size: 11px; color: #cbd5e1; }
                                Text { text: "Lista rápida o añadir archivo personalizado:"; font-size: 11px; color: #38bdf8; }
                            }

                            // Preset chips: Acer, ASUS, HP, Lenovo, Samsung, Auto
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Rectangle {
                                    height: 26px;
                                    background: (root.cfg_brand_logo == "assets/logos/acer.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "Acer")) ? #0284c7 : #1e293b;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: (root.cfg_brand_logo == "assets/logos/acer.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "Acer")) ? #38bdf8 : #475569;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.cfg_brand_logo = "assets/logos/acer.svg";
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: center;
                                        Text { text: "Acer"; font-size: 11px; font-weight: 700; color: #F5F5F5; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 26px;
                                    background: (root.cfg_brand_logo == "assets/logos/asus.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "ASUS")) ? #0284c7 : #1e293b;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: (root.cfg_brand_logo == "assets/logos/asus.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "ASUS")) ? #38bdf8 : #475569;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.cfg_brand_logo = "assets/logos/asus.svg";
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: center;
                                        Text { text: "ASUS"; font-size: 11px; font-weight: 700; color: #F5F5F5; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 26px;
                                    background: (root.cfg_brand_logo == "assets/logos/hp.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "HP")) ? #0284c7 : #1e293b;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: (root.cfg_brand_logo == "assets/logos/hp.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "HP")) ? #38bdf8 : #475569;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.cfg_brand_logo = "assets/logos/hp.svg";
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: center;
                                        Text { text: "HP"; font-size: 11px; font-weight: 700; color: #F5F5F5; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 26px;
                                    background: (root.cfg_brand_logo == "assets/logos/lenovo.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "Lenovo")) ? #0284c7 : #1e293b;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: (root.cfg_brand_logo == "assets/logos/lenovo.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "Lenovo")) ? #38bdf8 : #475569;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.cfg_brand_logo = "assets/logos/lenovo.svg";
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: center;
                                        Text { text: "Lenovo"; font-size: 11px; font-weight: 700; color: #F5F5F5; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 26px;
                                    background: (root.cfg_brand_logo == "assets/logos/samsung.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "Samsung")) ? #0284c7 : #1e293b;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: (root.cfg_brand_logo == "assets/logos/samsung.svg" || (root.cfg_brand_logo == "" && root.cfg_brand == "Samsung")) ? #38bdf8 : #475569;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.cfg_brand_logo = "assets/logos/samsung.svg";
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: center;
                                        Text { text: "Samsung"; font-size: 11px; font-weight: 700; color: #F5F5F5; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 26px;
                                    background: (root.cfg_brand_logo == "" && root.cfg_brand != "Acer" && root.cfg_brand != "ASUS" && root.cfg_brand != "HP" && root.cfg_brand != "Lenovo" && root.cfg_brand != "Samsung") ? #0284c7 : #1e293b;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: (root.cfg_brand_logo == "" && root.cfg_brand != "Acer" && root.cfg_brand != "ASUS" && root.cfg_brand != "HP" && root.cfg_brand != "Lenovo" && root.cfg_brand != "Samsung") ? #38bdf8 : #475569;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.cfg_brand_logo = "";
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: center;
                                        Text { text: "Auto"; font-size: 11px; font-weight: 700; color: #cbd5e1; vertical-alignment: center; }
                                    }
                                }
                            }

                            // Path input and file picker button
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text: root.cfg_brand_logo;
                                    placeholder-text: "assets/logos/lenovo.svg o archivo personalizado SVG/PNG";
                                    edited => { root.cfg_brand_logo = self.text; }
                                }
                                Rectangle {
                                    width: 125px;
                                    height: 32px;
                                    background: #1e293b;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #475569;
                                    touch_pick_brand_logo := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.pick_brand_logo_clicked(); }
                                    }
                                    states [
                                        hover when touch_pick_brand_logo.has-hover: {
                                            background: #0284c7;
                                            border-color: #38bdf8;
                                        }
                                    ]
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Text { text: "📁"; font-size: 13px; vertical-alignment: center; }
                                        Text { text: "Añadir Logo"; font-size: 11px; font-weight: 600; color: #F5F5F5; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Precio Tarjeta:"; font-size: 12px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_card_price;
                                    placeholder-text: "$000.000...";
                                    font-italic: self.text == "";
                                    edited => {
                                        root.cfg_card_price = self.text;
                                    }
                                    accepted => {
                                        root.cfg_card_price = root.format_currency_input(self.text);
                                        self.text = root.cfg_card_price;
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Precio Otros Medios:"; font-size: 12px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_normal_price;
                                    placeholder-text: "$000.000...";
                                    font-italic: self.text == "";
                                    edited => {
                                        root.cfg_normal_price = self.text;
                                    }
                                    accepted => {
                                        root.cfg_normal_price = root.format_currency_input(self.text);
                                        self.text = root.cfg_normal_price;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Código SKU:"; font-size: 12px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_sku;
                                    placeholder-text: "000000...";
                                    font-italic: self.text == "";
                                    edited => { root.cfg_sku = self.text; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Tienda / Retail:"; font-size: 12px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_retail;
                                    placeholder-text: "tienda...";
                                    font-italic: self.text == "";
                                    edited => { root.cfg_retail = self.text; }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            Rectangle {
                                height: 34px;
                                width: 180px;
                                background: #1e293b;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #475569;

                                touch_reset_0 := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.reset_store_defaults();
                                    }
                                }

                                states [
                                    hover when touch_reset_0.has-hover: {
                                        background: #334155;
                                        border-color: #38bdf8;
                                    }
                                ]

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../../assets/ui/reset.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: #38bdf8;
                                        }
                                    }
                                    Text { text: "Valores por defecto"; font-size: 12px; font-weight: 600; color: #f1f5f9; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    // TAB 1: ESPECIFICACIONES
                    if root.admin_tab_index == 1: VerticalLayout {
                        spacing: 8px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text { text: "Marca del Equipo (Badge):"; font-size: 11px; color: #cbd5e1; }
                                LineEdit {
                                    text: root.cfg_brand;
