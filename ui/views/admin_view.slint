                                                    text: "🎬";
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: root.cfg_central_video != "" ? root.cfg_central_video : "assets/videos/landing2.mp4";
                                                    font-size: 11px;
                                                    color: root.cfg_central_video != "" ? #F5F5F5 : #64748b;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            if root.cfg_central_video != "": Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: touch_clear_central.has-hover ? #ef444433 : #00000000;

                                                touch_clear_central := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.cfg_central_video = "";
                                                    }
                                                }

                                                Image {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 10px;
                                                    height: 10px;
                                                    source: @image-url("../../assets/ui/close.svg");
                                                    colorize: touch_clear_central.has-hover ? #ef4444 : #94a3b8;
                                                }
                                            }
                                        }
