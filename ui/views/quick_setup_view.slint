import { LineEdit } from "std-widgets.slint";

export component QuickSetupView inherits Rectangle {
    in-out property <string> setup_brand: "";
    in-out property <string> setup_model: "";
    in-out property <string> setup_retail: "";
    in-out property <string> setup_card_price: "";
    in-out property <string> setup_normal_price: "";
    in-out property <string> setup_sku: "";

    callback auto_detect_clicked();
    callback format_currency_input(string) -> string;
    callback save_quick_setup(string, string, string, string, string, string);

    width: 100%;
    height: 100%;
    background: #00000080;

    Rectangle {
        width: 620px;
        height: 560px;
        background: #F5F5F5;
        border-radius: 20px;
        border-width: 1px;
        border-color: #cbd5e1;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000033;
        drop-shadow-offset-y: 6px;

        VerticalLayout {
            padding-left: 36px;
            padding-right: 36px;
            padding-top: 30px;
            padding-bottom: 30px;
            spacing: 16px;

            Text {
                text: "Configuración Rápida de Exhibición";
                font-size: 22px;
                font-weight: 800;
                color: #0f172a;
            }

            Text {
                text: "Ingresa los datos comerciales del equipo para iniciar el showroom en tienda.";
                font-size: 13px;
                color: #64748b;
            }

            // Auto-detect Button
            Rectangle {
                height: 38px;
                background: #dcedf5;
                border-radius: 8px;
                border-width: 1px;
                border-color: #b8e2f5;

                detect_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.auto_detect_clicked();
                    }
                }

                Text {
                    text: "⚡ Auto-detectar Hardware del Equipo";
                    font-size: 13px;
                    font-weight: 700;
                    color: #0284c7;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "Marca:"; font-size: 12px; color: #475569; }
                    brand_ed := LineEdit {
                        text: root.setup_brand;
                        placeholder-text: "Ej: ASUS, HP";
                        edited => { root.setup_brand = self.text; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "Modelo:"; font-size: 12px; color: #475569; }
                    model_ed := LineEdit {
                        text: root.setup_model;
                        placeholder-text: "Ej: ROG Strix G16";
                        edited => { root.setup_model = self.text; }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "Precio Tarjeta:"; font-size: 12px; color: #475569; }
                    cprice_ed := LineEdit {
                        text: root.setup_card_price;
                        placeholder-text: "$000.000...";
                        font-italic: self.text == "";
                        edited => {
                            root.setup_card_price = self.text;
                        }
                        accepted => {
                            root.setup_card_price = root.format_currency_input(self.text);
                            self.text = root.setup_card_price;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "Precio Normal:"; font-size: 12px; color: #475569; }
                    nprice_ed := LineEdit {
                        text: root.setup_normal_price;
                        placeholder-text: "$000.000...";
                        font-italic: self.text == "";
                        edited => {
                            root.setup_normal_price = self.text;
                        }
                        accepted => {
                            root.setup_normal_price = root.format_currency_input(self.text);
                            self.text = root.setup_normal_price;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "SKU Tienda:"; font-size: 12px; color: #475569; }
                    sku_ed := LineEdit {
                        text: root.setup_sku;
                        placeholder-text: "000000...";
                        font-italic: self.text == "";
                        edited => { root.setup_sku = self.text; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Tienda Retail:"; font-size: 12px; color: #475569; }
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                border-radius: 4px;
                                background: root.setup_retail == "falabella" ? #e0f2fe : #f1f5f9;
                                border-width: 1px;
                                border-color: root.setup_retail == "falabella" ? #0284c7 : #cbd5e1;
                                HorizontalLayout {
                                    padding-left: 5px; padding-right: 5px; padding-top: 1px; padding-bottom: 1px;
                                    Text { text: "🛍️ Falabella"; font-size: 9px; font-weight: 700; color: root.setup_retail == "falabella" ? #0369a1 : #475569; }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { root.setup_retail = "falabella"; } }
                            }
                            Rectangle {
                                border-radius: 4px;
                                background: root.setup_retail == "ripley" ? #f3e8ff : #f1f5f9;
                                border-width: 1px;
                                border-color: root.setup_retail == "ripley" ? #9333ea : #cbd5e1;
                                HorizontalLayout {
                                    padding-left: 5px; padding-right: 5px; padding-top: 1px; padding-bottom: 1px;
                                    Text { text: "🟣 Ripley"; font-size: 9px; font-weight: 700; color: root.setup_retail == "ripley" ? #7e22ce : #475569; }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { root.setup_retail = "ripley"; } }
                            }
                            Rectangle {
                                border-radius: 4px;
                                background: root.setup_retail == "paris" ? #eff6ff : #f1f5f9;
                                border-width: 1px;
                                border-color: root.setup_retail == "paris" ? #2563eb : #cbd5e1;
                                HorizontalLayout {
                                    padding-left: 5px; padding-right: 5px; padding-top: 1px; padding-bottom: 1px;
                                    Text { text: "🔵 Paris"; font-size: 9px; font-weight: 700; color: root.setup_retail == "paris" ? #1d4ed8 : #475569; }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { root.setup_retail = "paris"; } }
                            }
                        }
                    }
                    retail_ed := LineEdit {
                        text: root.setup_retail;
                        placeholder-text: "tienda...";
                        font-italic: self.text == "";
                        edited => { root.setup_retail = self.text; }
                    }
                }
            }

            // Submit button
            Rectangle {
                height: 48px;
                background: #0284c7;
                border-radius: 10px;

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.save_quick_setup(
                            root.setup_brand,
                            root.setup_model,
                            root.setup_card_price,
                            root.setup_normal_price,
                            root.setup_sku,
                            root.setup_retail
                        );
                    }
                }

                Text {
                    text: "Guardar y Comenzar Showroom";
                    font-size: 15px;
                    font-weight: 800;
                    color: #F5F5F5;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
