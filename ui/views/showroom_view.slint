import { SpecCard } from "../components/spec_card.slint";
import { SpecItem } from "../theme.slint";

export component ShowroomView inherits Rectangle {
    in property <string> brand_name: "ASUS";
    in property <string> model_name: "ROG STRIX G16";
    in property <string> live_clock: "12:00:00";
    in property <string> retail_name: "";
    in property <string> card_price: "";
    in property <string> card_label: "Precio Tarjeta";
    in property <string> normal_price: "";
    in property <string> normal_label: "Todo medio de pago";
    in property <string> sku_code: "";
    in property <image> store_logo;
    in property <image> brand_logo;
    in property <bool> has_brand_logo: false;
    in property <image> brand_logo_dark;
    in property <bool> has_brand_logo_dark: false;
    in property <bool> is_dark_mode: false;
    in property <bool> is_dark_bg: false;

    in property <[SpecItem]> left_specs;
    in property <[SpecItem]> right_specs;

    in property <image> video_frame;
    in property <bool> has_video_stream: false;
    in property <length> screen_width: 1920px;
    in property <length> screen_height: 1080px;

    // Theme Colors
    in property <color> theme_bg_start: #dcedf5;
    in property <color> theme_bg_mid: #e3e8f5;
    in property <color> theme_bg_end: #eae4f5;
    in property <color> theme_card_bg: #F5F5F5;
    in property <color> theme_card_border: #e2e8f0;
    in property <color> theme_text_primary: #0f172a;
    in property <color> theme_text_secondary: #64748b;
    in property <color> theme_accent: #0284c7;
    in property <color> theme_btn_bg: #0284c7;
    in property <color> theme_btn_text: #F5F5F5;
    in property <bool> is_dimmed: false;

    callback try_pc_clicked();
    callback corner_tap_clicked();

    property <bool> pulse_active: false;
    property <int> shift_step: 0;
    property <length> oled_offset_x: 0px;
    property <length> oled_offset_y: 0px;

    pulse_timer := Timer {
        interval: 1200ms;
        running: true;
        triggered => {
            root.pulse_active = !root.pulse_active;
        }
    }

    // OLED Pixel Shifting Timer: Cycles position every 60s in an orbit (-2px to +2px)
    oled_shift_timer := Timer {
        interval: 60s;
        running: true;
        triggered => {
            root.shift_step = (root.shift_step + 1) >= 8 ? 0 : (root.shift_step + 1);
            if root.shift_step == 0 {
                root.oled_offset_x = 0px;
                root.oled_offset_y = 0px;
            } else if root.shift_step == 1 {
                root.oled_offset_x = 1.5px;
                root.oled_offset_y = 1px;
            } else if root.shift_step == 2 {
                root.oled_offset_x = 2px;
                root.oled_offset_y = 0px;
            } else if root.shift_step == 3 {
                root.oled_offset_x = 1.5px;
                root.oled_offset_y = -1px;
            } else if root.shift_step == 4 {
                root.oled_offset_x = 0px;
                root.oled_offset_y = -1.5px;
            } else if root.shift_step == 5 {
                root.oled_offset_x = -1.5px;
                root.oled_offset_y = -1px;
            } else if root.shift_step == 6 {
                root.oled_offset_x = -2px;
                root.oled_offset_y = 0px;
            } else {
                root.oled_offset_x = -1.5px;
                root.oled_offset_y = 1px;
            }
        }
    }

    animate oled_offset_x {
        duration: 1200ms;
        easing: ease-in-out;
    }
    animate oled_offset_y {
        duration: 1200ms;
        easing: ease-in-out;
    }

    width: 100%;
    height: 100%;
    background: @linear-gradient(155deg, root.theme_bg_start 0%, root.theme_bg_mid 50%, root.theme_bg_end 100%);

    // Top-Left Ambient Pastel Sky Aura (Solo en modo claro)
    if !root.is_dark_mode && !root.is_dark_bg: Rectangle {
        width: 750px;
        height: 750px;
        x: -200px;
        y: -200px;
        border-radius: 375px;
        background: @linear-gradient(135deg, #38bdf812 0%, #00000000 75%);
    }

    // Top-Right Ambient Pastel Mint Aura (Solo en modo claro)
    if !root.is_dark_mode && !root.is_dark_bg: Rectangle {
        width: 650px;
        height: 650px;
        x: parent.width - 400px;
        y: -200px;
        border-radius: 325px;
        background: @linear-gradient(225deg, #34d3990c 0%, #00000000 75%);
    }

    // Bottom-Right Ambient Pastel Lavender Aura (Solo en modo claro)
    if !root.is_dark_mode && !root.is_dark_bg: Rectangle {
        width: 850px;
        height: 850px;
        x: parent.width - 500px;
        y: parent.height - 450px;
        border-radius: 425px;
        background: @linear-gradient(315deg, #c084fc10 0%, #00000000 75%);
    }

    // Center Ambient Depth Aura behind Showcase Cards and Central Video (Solo en modo claro)
    if !root.is_dark_mode && !root.is_dark_bg: Rectangle {
        width: 960px;
        height: 700px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 350px;
        background: @linear-gradient(180deg, #0284c708 0%, #00000000 85%);
    }

    // MAIN CONTENT (Protected by OLED pixel shifting)
    main_content := VerticalLayout {
        x: root.oled_offset_x;
        y: root.oled_offset_y;
        property <length> side_col_w: min(340px, root.screen_width * 21%);
        property <length> video_h: min((root.screen_width - min(680px, root.screen_width * 42%) - 40px) * 9 / 16, root.screen_height * 56%);
        property <length> center_w: self.video_h * 16 / 9;
        // Espaciado uniforme para los 4 huecos horizontales: [pad_left] Col1 [gap] Centro [gap] Col2 [pad_right]
        property <length> uniform_gap: max(16px, (root.screen_width - (self.side_col_w * 2) - self.center_w) / 4);

        padding-left: self.uniform_gap;
        padding-right: self.uniform_gap;
        padding-top: 18px;
        padding-bottom: 18px;
        spacing: 14px;

        // TOP HEADER BAR
        HorizontalLayout {
            height: 52px;
            alignment: end;

            // Right: Clock & Hidden Trigger
            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    Rectangle {
                        height: 38px;
                        background: root.theme_card_bg;
                        border-radius: 10px;
                        border-width: 1.5px;
                        border-color: root.theme_card_border;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;

                            Text {
                                text: root.live_clock;
                                font-size: 15px;
                                font-weight: 700;
                                color: root.theme_text_primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 4-tap trigger target (corner)
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 10px;
                        background: root.theme_card_bg;
                        border-width: 1.5px;
                        border-color: root.theme_card_border;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.corner_tap_clicked();
                            }
                        }

                        Text {
                            text: "⚙";
                            font-size: 14px;
                            color: root.theme_text_secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 3-COLUMN SHOWROOM BODY
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: main_content.uniform_gap;

            // LEFT COLUMN (Specs 1 to 4)
            Rectangle {
                width: main_content.side_col_w;

                VerticalLayout {
                    spacing: root.screen_height < 900px ? 8px : 10px;

                    for item in root.left_specs: SpecCard {
                        category: item.category;
                        value: item.value;
                        subvalue: item.subvalue;
                        tag: item.tag;
                        icon: item.icon;
                        accent_color: root.theme_accent;
                        card_bg: root.theme_card_bg;
                        card_border: root.theme_card_border;
                        text_primary: root.theme_text_primary;
                        text_secondary: root.theme_text_secondary;
                        category_color: root.theme_accent;
                    }
                }
            }

            // CENTER HERO (Media & Pricing)
            Rectangle {
                width: main_content.center_w;

                VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    // Brand & Model Module above landing video (4 cards on left, 4 cards on right)
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        height: 70px;

                        // Brand: Vector Logo if available, or prominent text
                        HorizontalLayout {
                            alignment: center;

                            if root.has_brand_logo: Image {
                                source: (root.is_dark_mode || root.is_dark_bg) && root.has_brand_logo_dark ? root.brand_logo_dark : root.brand_logo;
                                height: 38px;
                                image-fit: contain;
                            }

                            if !root.has_brand_logo: Text {
                                text: root.brand_name;
                                font-size: 32px;
                                font-weight: 900;
                                color: root.theme_text_primary;
                                letter-spacing: 2.5px;
                                horizontal-alignment: center;
                            }
                        }

                        // Model: Subtitle in smaller font
                        if root.model_name != "": Text {
                            text: root.model_name;
                            font-size: 14px;
                            font-weight: 700;
                            color: root.theme_accent;
                            letter-spacing: 1.2px;
                            horizontal-alignment: center;
                        }
                    }

                    // Video Frame (proporcional 16:9 exacto, más amplio y sin barras)
                    HorizontalLayout {
                        alignment: center;

                        video_box := Rectangle {
                            height: min((root.screen_width - min(680px, root.screen_width * 42%) - 40px) * 9 / 16, root.screen_height * 56%);
                            width: self.height * 16 / 9;
                            background: #000000;
                            border-radius: 18px;
                            border-width: 2px;
                            border-color: #cbd5e1;
                            clip: true;

                            // Glow background
                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                background: @linear-gradient(180deg, #0284c71a 0%, #00000000 100%);
                            }

                            // libmpv Video Stream (16:9 nativo)
                            if root.has_video_stream: Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.video_frame;
                                image-fit: fill;
                            }

                        // Center Showcase Badge (shown ONLY when no video stream)
                            if !root.has_video_stream: VerticalLayout {
                            alignment: center;
                            spacing: 14px;
                            padding-left: 30px;
                            padding-right: 30px;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 60px;
                                    width: 60px;
                                    border-radius: 30px;
                                    background: #dcedf5;
                                    border-width: 2px;
                                    border-color: #0284c7;

                                    Text {
                                        text: "▶";
                                        font-size: 26px;
                                        color: #0284c7;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: "EQUIPO DISPONIBLE PARA PRUEBA INMEDIATA";
                                font-size: 12px;
                                font-weight: 800;
                                color: #0284c7;
                                letter-spacing: 2px;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.brand_name + " " + root.model_name;
                                font-size: 26px;
                                font-weight: 800;
                                color: #F5F5F5;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Experimenta la velocidad, potencia de gráficos y fluidez en tiempo real";
                                font-size: 13px;
                                color: #cbd5e1;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                    // PRICING & SKU BANNER (Barra de precios igualada al ancho del video)
                    if root.card_price != "" || root.normal_price != "" || root.sku_code != "" || root.retail_name != "": HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: video_box.width;
                            height: 106px;
                            background: root.theme_card_bg;
                            border-radius: 16px;
                            border-width: 1.5px;
                            border-color: root.theme_card_border;

                        VerticalLayout {
                            alignment: center;

                            HorizontalLayout {
                                padding-left: 32px;
                                padding-right: 32px;
                                alignment: center;
                                spacing: 36px;

                                // Card Price Block (Featured Promo)
                                if root.card_price != "": HorizontalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    spacing: 16px;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 52px;
                                            height: 52px;
                                            border-radius: 26px;
                                            background: root.theme_bg_end;
                                            border-width: 1px;
                                            border-color: root.theme_card_border;

                                            if root.retail_name == "FALABELLA": Image {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                source: @image-url("../../assets/images/T-FALABELLA.svg");
                                                width: 38px;
                                                height: 24px;
                                                image-fit: contain;
                                            }
                                            if root.retail_name == "RIPLEY": Image {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                source: @image-url("../../assets/images/T-RIPLEY.svg");
                                                width: 38px;
                                                height: 24px;
                                                image-fit: contain;
                                            }
                                            if root.retail_name == "PARIS": Image {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                source: @image-url("../../assets/images/T-CENCOSUD.svg");
                                                width: 38px;
                                                height: 24px;
                                                image-fit: contain;
                                            }
                                            if root.retail_name != "FALABELLA" && root.retail_name != "RIPLEY" && root.retail_name != "PARIS": Text {
                                                text: "💳";
                                                font-size: 26px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: root.card_label;
                                            font-size: 13px;
                                            font-weight: 800;
                                            color: root.retail_name == "FALABELLA" ? ((root.is_dark_mode || root.is_dark_bg) ? #84cc16 : #65a30d) : root.retail_name == "PARIS" ? #0284c7 : root.retail_name == "RIPLEY" ? ((root.is_dark_mode || root.is_dark_bg) ? #a855f7 : #7c3aed) : root.theme_accent;
                                            letter-spacing: 0.8px;
                                        }

                                        Text {
                                            text: root.card_price;
                                            font-size: 42px;
                                            font-weight: 900;
                                            color: root.retail_name == "FALABELLA" ? ((root.is_dark_mode || root.is_dark_bg) ? #84cc16 : #65a30d) : root.retail_name == "PARIS" ? #0284c7 : root.retail_name == "RIPLEY" ? ((root.is_dark_mode || root.is_dark_bg) ? #a855f7 : #7c3aed) : root.theme_accent;
                                        }
                                    }
                                }

                                // Divider between Card and Normal Price
                                if root.card_price != "" && root.normal_price != "": VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Rectangle {
                                        width: 1.5px;
                                        height: 58px;
                                        background: root.theme_card_border;
                                    }
                                }

                                // Normal Price Block
                                if root.normal_price != "": VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    spacing: 2px;

                                    Text {
                                        text: root.normal_label;
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: root.theme_text_secondary;
                                        letter-spacing: 0.5px;
                                    }

                                    Text {
                                        text: root.normal_price;
                                        font-size: 32px;
                                        font-weight: 800;
                                        color: root.theme_text_primary;
                                    }
                                }

                                // Divider between Prices and Store/SKU
                                if (root.card_price != "" || root.normal_price != "") && (root.sku_code != "" || root.retail_name != ""): VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Rectangle {
                                        width: 1.5px;
                                        height: 58px;
                                        background: root.theme_card_border;
                                    }
                                }

                                // Store & SKU Block
                                if root.sku_code != "" || root.retail_name != "": HorizontalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    spacing: 20px;

                                    // Store Logo or Name Badge
                                    if root.store_logo.width > 0: VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: root.store_logo;
                                            height: 68px;
                                            max-width: 180px;
                                            image-fit: contain;
                                        }
                                    }
                                    if root.store_logo.width <= 0 && root.retail_name != "": VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 44px;
                                            background: root.theme_bg_end;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: root.theme_card_border;

                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                alignment: center;
                                                Text {
                                                    text: root.retail_name;
                                                    font-size: 15px;
                                                    font-weight: 800;
                                                    color: root.theme_text_primary;
                                                    letter-spacing: 1px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // SKU Pill Badge
                                    if root.sku_code != "": VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 38px;
                                            background: root.theme_bg_end;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: root.theme_card_border;

                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                alignment: center;
                                                spacing: 4px;

                                                Text {
                                                    text: "SKU:";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: root.theme_text_secondary;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: root.sku_code;
                                                    font-size: 14px;
                                                    font-weight: 800;
                                                    color: root.theme_text_primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                    // Botón PROBAR ESTA PC (Debajo de la barra que recibe los precios)
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: center;
                            height: 78px;

                            Rectangle {
                                width: 456px;
                                height: 78px;

                                // Halo sutil de pulsación (aura que respira suavemente)
                                Rectangle {
                                    width: root.pulse_active ? 452px : 442px;
                                    height: root.pulse_active ? 74px : 68px;
                                    border-radius: 14px;
                                    background: root.theme_accent;
                                    opacity: btn_touch.has-hover ? 0.45 : (root.pulse_active ? 0.35 : 0.08);

                                    animate width, height, opacity {
                                        duration: 1200ms;
                                        easing: ease-in-out;
                                    }
                                }

                                btn_container := Rectangle {
                                    height: btn_touch.pressed ? 64px : 68px;
                                    width: btn_touch.pressed ? 434px : 440px;
                                    border-radius: 12px;
                                    background: btn_touch.pressed ? root.theme_btn_bg.darker(15%) : root.theme_btn_bg;
                                    border-width: 2.5px;
                                    border-color: btn_touch.has-hover ? #F5F5F5 : (root.pulse_active ? #ffffff : root.theme_accent);

                                    animate border-color {
                                        duration: 1200ms;
                                        easing: ease-in-out;
                                    }
                                    animate width, height, background {
                                        duration: 90ms;
                                        easing: ease-out;
                                    }

                                    btn_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.try_pc_clicked();
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        padding-left: 24px;
                                        padding-right: 24px;

                                        Text {
                                            text: "PROBAR ESTA PC";
                                            font-size: 22px;
                                            font-weight: 900;
                                            color: root.theme_btn_text;
                                            letter-spacing: 1.5px;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "Explora Windows libremente. Toca 'Ver detalles' cuando quieras volver";
                            font-size: 11px;
                            font-weight: 600;
                            color: root.theme_text_secondary;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // RIGHT COLUMN (Specs 5 to 8)
            Rectangle {
                width: main_content.side_col_w;

                VerticalLayout {
                    spacing: root.screen_height < 900px ? 8px : 10px;

                    for item in root.right_specs: SpecCard {
                        category: item.category;
                        value: item.value;
                        subvalue: item.subvalue;
                        tag: item.tag;
                        icon: item.icon;
                        accent_color: root.theme_accent;
                        card_bg: root.theme_card_bg;
                        card_border: root.theme_card_border;
                        text_primary: root.theme_text_primary;
                        text_secondary: root.theme_text_secondary;
                        category_color: root.theme_accent;
                    }
                }
            }
        }
    }

    // OLED Static Content Inactivity Dimming Overlay
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;
        opacity: root.is_dimmed ? 0.10 : 0.0;
        animate opacity {
            duration: 800ms;
            easing: ease-in-out;
        }
    }
}
